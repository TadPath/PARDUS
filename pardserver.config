###################################################
#                                                 #
#  PARDserver configuration file.                 #
#                                                 #
###################################################

# File format version for backwards compatibility:
config_version 1

# Encryption keys file:
key_file  server_identity.key

# User credentials file:
user_database pardusers.txt

# Path to connect to the Arduino or other breakout-board (bob)
# e.g. /dev/ttyACM0 or /dev/ttyUSB0 or 'auto' for autodetection or 'nobob' if
# you have no Arduino (or other) breakout board and just want to use the local
# facilities (+/ pardcap facilities) of the PCS programming language:
bob_path auto

# PARDcapture server connections
# Format: pardcap <ipv4> <port>
# Loopback
# pardcap 127.0.0.1 16118
# additional connections as required e.g.
# Loopback:
# pardcap 127.0.0.1 16119
# RPi IMX296LL/OV5460:
# pardcap 192.168.1.30 16118
# pardcap 192.168.7.30 16118
# etc.

# Port the pardserver will connect on (1024 - 65535):
server_port 5555

# Name of the pardserver (a string with no white space):
server_name              Pardus1

# Password Security Policies
pwdpol_strike_limit      3          # Strikes before account lockout
pwdpol_strikeout_delay   0          # Lockout timer duration (seconds)
pwdpol_expiry_timeout    0          # Password age lifespan (seconds)
pwdpol_min_length        4          # Minimum acceptable length boundary
pwdpol_needs_upper       0          # Complexity requirement toggles (0 or 1)
pwdpol_needs_lower       0          # Use 0 if you do not want that
pwdpol_needs_digit       0          # requirement to be enforced and 1 if
pwdpol_needs_special     0          # you do.

# Verbosity for server logging (0 to 2), 0 = silent:
verbosity 0

# End of config settings marker
exit

==============================
ADMINISTRATIVE SCRATCHPAD AREA
==============================
All text after 'exit' will be ignored by the pardserver parser. This space may therefore be used for any free text notes, deployment logs, or server setup reminders, etc. without any special formatting.

----------------------------------------------------------------------
