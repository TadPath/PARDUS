    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <!-- Strings: Yellow-Orange -->
        <DetectChar attribute="String" context="StringQ" char="&quot;" />
        <DetectChar attribute="String" context="StringS" char="'" />

        <RegExpr attribute="Preprocessor" context="#stay" String="#(define|include|include_once)\b" />
        <DetectChar attribute="Comment" context="CommentContext" char="#" />

        <!-- Folding Blocks -->
        <StringDetect attribute="Keyword" context="#stay" String="do_if" beginRegion="Conditional" />
        <StringDetect attribute="Keyword" context="#stay" String="else" endRegion="Conditional" beginRegion="Conditional" />
        <StringDetect attribute="Keyword" context="#stay" String="enddo" endRegion="Conditional" />
        <StringDetect attribute="Keyword" context="#stay" String="loop_while" beginRegion="Loop" />
        <StringDetect attribute="Keyword" context="#stay" String="endloop" endRegion="Loop" />
        <StringDetect attribute="Keyword" context="#stay" String="def_func" beginRegion="Function" />
        <StringDetect attribute="Keyword" context="#stay" String="return" endRegion="Function" />

        <!-- Highlighting Rules -->
        <keyword attribute="Keyword" context="#stay" String="keywords" />
        <keyword attribute="System Variable" context="#stay" String="sysvars" />
        <keyword attribute="Data Type" context="#stay" String="types" />
        
        <!-- Numbers: Green -->
        <Float attribute="Decimal" context="#stay" />
        <Int attribute="Decimal" context="#stay" />
      </context>

      <!-- Context for Double Quotes -->
      <context name="StringQ" attribute="String" lineEndContext="#pop">
        <DetectChar attribute="String" context="#pop" char="&quot;" />
      </context>
      <!-- Context for Single Quotes -->
      <context name="StringS" attribute="String" lineEndContext="#pop">
        <DetectChar attribute="String" context="#pop" char="'" />
      </context>
      
      <context name="CommentContext" attribute="Comment" lineEndContext="#pop" />
    </contexts>

    <itemDatas>
      <itemData name="Normal Text"  defStyleNum="dsNormal" />
      <itemData name="Keyword"      defStyleNum="dsKeyword" color="#0000ff" bold="1" />
      <itemData name="Data Type"    defStyleNum="dsDataType" color="#008000" bold="1" />
      <itemData name="System Variable" defStyleNum="dsVariable" color="#008080" bold="1" />
      <itemData name="Preprocessor" defStyleNum="dsPreprocessor" color="#a020f0" />
      <itemData name="Comment"      defStyleNum="dsComment" color="#ff0000" />
      <itemData name="Decimal"      defStyleNum="dsDecVal" color="#00a000" /> <!-- Green -->
      <itemData name="String"       defStyleNum="dsString" color="#ff8c00" /> <!-- Orange-Yellow -->
    </itemDatas>
