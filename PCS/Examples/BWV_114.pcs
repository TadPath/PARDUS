#define A1_NATL_B  19  # Maps to A1_NATL_16
#define B1_NATL_B  20  # Maps to B1_NATL_16
#define C3_SHRP_B  21  # Maps to C3_SHRP_16 
#define REST_B     22 

# TREBLE DEFINITIONS (8-Bit Timer Context)
#define D6_NATL_T  1   # Maps to D6_NATL_8
#define G5_NATL_T  2   # Maps to G5_NATL_8
#define A5_NATL_T  3   # Maps to A5_NATL_8
#define B5_NATL_T  4   # Maps to B5_NATL_8
#define C6_NATL_T  5   # Maps to C6_NATL_8
