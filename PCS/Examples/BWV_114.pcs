#define F6_SHRP_T  7   # Maps to F6_SHRP_8
#define G6_NATL_T  8   # Maps to G6_NATL_8
#define F5_SHRP_T  9   # Maps to F5_SHRP_8
#define F5_NATL_T  10  # Maps to F5_NATL_8 
#define E5_NATL_T  11  # Maps to E5_NATL_8 
#define D5_NATL_T  12  # Maps to D5_NATL_8 
#define C5_NATL_T  13  # Maps to C5_NATL_8 
#define A4_NATL_T  14  # Maps to A4_NATL_8 
#define B6_NATL_T  15  # Maps to B6_NATL_8 
#define A6_NATL_T  16  # Maps to A6_NATL_8 
#define C6_SHRP_T  17  # Maps to C6_SHRP_8  




    # =====================================================================
    # PLAY ORDER ARRAYS
    # =====================================================================
    def_array int BassSeq 192 0
    def_array int TrebleSeq 192 0

    # --- Treble Sequence Mapping ---
    # M1:
    set_var TrebleSeq[0] D6_NATL_T
    set_var TrebleSeq[1] 0
    set_var TrebleSeq[2] G5_NATL_T
    set_var TrebleSeq[3] A5_NATL_T
