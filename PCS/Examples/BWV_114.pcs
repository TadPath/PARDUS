Pardus pcs 1
verbosity 1
gui_update_period 17 # Keep the gui alive for a bit to allow the 'Interrupt' button to show

# First-Class Pointer Arrangement of "Minuet in G Major" (BWV Anh. 114)

#include music.pch
#include stdpard.pch

# --- GLOBAL VARIABLES & POINTERS ---
# (Moved outside the loop to respect global scope and prevent re-definition errors)
def_var string actname1 _
def_var string actname2 _
def_var int current_pitch1 0
def_var int current_pitch2 0
def_var int duty 0
def_var int step_idx 0
def_var int target_bass_ptr 0
def_var int target_treble_ptr 0
def_var float sleep_time 0.0

def_func main
    get_actuators

# Safety Layer: Clean up any pre-existing actuators of the same type and ID to
# the ones we will be definitng below (even if they are of a different name) to
# prevent duplicate definition errors later:

act_getname ACT_MLEVEL 1 actname1
set_condexp actname1 != null
do_if Condexp
  undef_actuator actname1
enddo

act_getname ACT_MLEVEL 2 actname2
set_condexp actname2 != null
do_if Condexp
  undef_actuator actname2
enddo

    # 1. Instantiate 16-BIT BASS voice channel
    def_actuator ACT_MLEVEL 1 ML_pwm1
    act_set ML_pwm1 INFO_ML_TYPE  MLT_PWM        
    act_set ML_pwm1 INFO_ML_PSC   PWM_PSC_8      
    act_set ML_pwm1 INFO_PIN_P0  9               
    
    # 2. Instantiate 8-BIT TREBLE voice channel
    def_actuator ACT_MLEVEL 2 ML_pwm2
    act_set ML_pwm2 INFO_ML_TYPE  MLT_PWM        
    act_set ML_pwm2 INFO_ML_PSC   PWM_PSC_256    
    act_set ML_pwm2 INFO_PIN_P0  3               

    # =====================================================================
    # COMPACT TRANSLATION TABLES (Unique Pitches Only)
    # =====================================================================
    
    # BASS DEFINITIONS (23 Unique states)
    act_set ML_pwm1 INFO_ML_TTABLE  0   0           500  # Sustain
    act_set ML_pwm1 INFO_ML_TTABLE  1   G2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  2   B2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  3   C3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  4   D3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  5   A2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  6   F3_SHRP_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  7   G3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  8   A3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  9   C4_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  10  B3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  11  F2_SHRP_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  12  E2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  13  F2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  14  E3_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  15  C2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  16  G3_SHRP_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  17  D2_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  18  G1_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  19  A1_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  20  B1_NATL_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  21  C3_SHRP_16  500
    act_set ML_pwm1 INFO_ML_TTABLE  22  1           0   # Rest

    # TREBLE DEFINITIONS (18 Unique states)
    act_set ML_pwm2 INFO_ML_TTABLE  0   0           500  # Sustain
    act_set ML_pwm2 INFO_ML_TTABLE  1   D6_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  2   G5_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  3   A5_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  4   B5_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  5   C6_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  6   E6_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  7   F6_SHRP_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  8   G6_NATL_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  9   F5_SHRP_8   500
    act_set ML_pwm2 INFO_ML_TTABLE  10  F5_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  11  E5_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  12  D5_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  13  C5_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  14  A4_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  15  B6_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  16  A6_NATL_8   500  
    act_set ML_pwm2 INFO_ML_TTABLE  17  C6_SHRP_8   500  


# BASS DEFINITIONS (16-Bit Timer Context)
#define G2_NATL_B  1   # Maps to G2_NATL_16
#define B2_NATL_B  2   # Maps to B2_NATL_16
#define C3_NATL_B  3   # Maps to C3_NATL_16
#define D3_NATL_B  4   # Maps to D3_NATL_16
#define A2_NATL_B  5   # Maps to A2_NATL_16
#define F3_SHRP_B  6   # Maps to F3_SHRP_16
#define G3_NATL_B  7   # Maps to G3_NATL_16
#define A3_NATL_B  8   # Maps to A3_NATL_16
#define C4_NATL_B  9   # Maps to C4_NATL_16
#define B3_NATL_B  10  # Maps to B3_NATL_16
#define F2_SHRP_B  11  # Maps to F2_SHRP_16
#define E2_NATL_B  12  # Maps to E2_NATL_16
