    set_var BassSeq[191] 0




    # =====================================================================
    # PLAY 
    # =====================================================================

#define STARTING_POINT 0    
set_var step_idx STARTING_POINT
set_condexp step_idx == STARTING_POINT

gui_update_period 0 # Don't waste cycles on the GUI

loop_while Condexp

    # Set the base rest period
    set_var sleep_time 0.175

    # Pull the exact pointer value out of our sequence arrays
    set_var target_bass_ptr BassSeq[step_idx]
    set_var target_treble_ptr TrebleSeq[step_idx]

    # Get the frequency values from the translation tables via our pointers
    act_get ML_pwm1 INFO_ML_TTABLE target_bass_ptr current_pitch1 duty
    act_get ML_pwm2 INFO_ML_TTABLE target_treble_ptr current_pitch2 duty

    # Activate the actuators if they are not in a sustain period 
    do_if current_pitch1
       act_set ML_pwm1 INFO_ML_LEVEL target_bass_ptr
       sub_var sleep_time 0.051 # Correct rest for time it takes to do this
    enddo

    do_if current_pitch2
       act_set ML_pwm2 INFO_ML_LEVEL target_treble_ptr
       sub_var sleep_time 0.051 # Correct rest for time it takes to do this
    enddo
    
    # Wait the alloted time to pace the music
    sleep sleep_time                 
    
    add_var step_idx 1
    set_condexp step_idx <= 191            
endloop
    
    act_halt ML_pwm1
    act_halt ML_pwm2
    
return
exit
