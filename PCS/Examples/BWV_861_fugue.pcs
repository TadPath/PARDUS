    # ---- bar 34 ----
    set_var BassSeq[528] REST_B    # b34.1.1 rest
    set_var BassSeq[529] 0
    set_var BassSeq[530] A3_NATL_B    # b34.1.3 A3 (T)
    set_var BassSeq[531] B3_FLAT_B    # b34.1.4 Bb3 (T)
    set_var BassSeq[532] C4_NATL_B    # b34.2.1 C4 (T)
    set_var BassSeq[533] 0
    set_var BassSeq[534] B3_FLAT_B    # b34.2.3 Bb3 (T)
    set_var BassSeq[535] A3_NATL_B    # b34.2.4 A3 (T)
    set_var BassSeq[536] G2_NATL_B    # b34.3.1 G2 (B)
    set_var BassSeq[537] 0
    set_var BassSeq[538] 0
    set_var BassSeq[539] 0
    set_var BassSeq[540] 0
    set_var BassSeq[541] 0
    set_var BassSeq[542] 0
    set_var BassSeq[543] 0

    # =====================================================================
    # PLAY
    #   Each pass of the loop is one semiquaver.  For each voice:
    #     - a 0 in the play-order array sends nothing (the note rings on);
    #     - otherwise the row number is sent with act_set INFO_ML_LEVEL.
    #   Testing the pointer directly is equivalent to the act_get test of the
    #   example script (row 0 is the only row with frequency 0) and saves two
    #   client-server round trips per step, which reduces timing jitter.
    #
    #   Re-articulation: the server caches the last level sent to an M-Level
    #   actuator and suppresses duplicate calls, so two consecutive notes of
    #   the same pitch would otherwise fuse into one.  When the new row equals
    #   the row already sounding, a rest is sent first and a short gap is
    #   inserted, so that the ear hears two notes.  Ties in the score are
    #   encoded as sustains (0) and are therefore NOT re-articulated.
    # =====================================================================
    set_str msg BWV 861 Fuga XVI - playing
    print_value msg 2
    set_var step_idx STARTING_POINT
    set_condexp step_idx <= LAST_STEP
    loop_while Condexp
        set_var sleep_time STEP_SECONDS         # nominal duration of this step
        set_var bass_ptr BassSeq[step_idx]      # 0, a note row, or REST_B
        set_var treble_ptr TrebleSeq[step_idx]  # 0, a note row, or REST_T

        # --- decide whether either voice repeats the pitch already sounding ---
        set_var bass_retrig 0
        set_var treble_retrig 0
        do_if ARTICULATE_REPEATS
            do_if bass_ptr
                set_condexp bass_ptr == bass_sounding
                set_var bass_retrig Condexp
            enddo
            do_if treble_ptr
                set_condexp treble_ptr == treble_sounding
                set_var treble_retrig Condexp
            enddo
        enddo

        # --- phase 1: silence the voices that must re-articulate, then a short gap ---
        do_if bass_retrig
            act_set ML_pwm1 INFO_ML_LEVEL REST_B
            sub_var sleep_time ACT_SET_LATENCY
        enddo
        do_if treble_retrig
            act_set ML_pwm2 INFO_ML_LEVEL REST_T
            sub_var sleep_time ACT_SET_LATENCY
        enddo
        set_condexp bass_retrig || treble_retrig
        do_if Condexp
            sleep ARTIC_GAP
            sub_var sleep_time ARTIC_GAP
        enddo

        # --- phase 2: sound the new events (notes or rests) ---
        do_if bass_ptr
            act_set ML_pwm1 INFO_ML_LEVEL bass_ptr
            sub_var sleep_time ACT_SET_LATENCY
            set_var bass_sounding bass_ptr
        enddo
        do_if treble_ptr
            act_set ML_pwm2 INFO_ML_LEVEL treble_ptr
            sub_var sleep_time ACT_SET_LATENCY
            set_var treble_sounding treble_ptr
        enddo

        # --- pace the music (sleep must never receive a negative value) ---
        set_condexp sleep_time < 0.0
        do_if Condexp
            set_var sleep_time 0.0
        enddo
        sleep sleep_time

        add_var step_idx 1
        set_condexp step_idx <= LAST_STEP
    endloop

    # The final chord carries a fermata in the score: hold it, then silence.
    sleep FERMATA_HOLD
    act_halt ML_pwm1
    act_halt ML_pwm2
    set_str msg BWV 861 Fuga XVI - finished
    print_value msg 2
return
exit

