Pardus pcs 1
verbosity 1

###############################################################################
#  J. S. Bach - Das Wohltemperierte Clavier I, Fuga XVI in G minor, BWV 861   #
#  Two-voice phrase reduction for two PWM M-Level actuators                   #
#                                                                             #
#     ML_pwm1  = BASS   voice (tenor + bass amalgam),   16-bit timer, PSC 8   #
#     ML_pwm2  = TREBLE voice (soprano + alto amalgam),  8-bit timer, PSC 256 #
#                                                                             #
#  Generated by build.py from Bach_BWV_861.ly (Mutopia, Bach Gesellschaft     #
#  edition) using the phrase-reduction method described in the accompanying   #
#  document.  Time base: one semiquaver per step, 16 steps per bar,           #
#  34 bars = 544 steps.  Tempo: crotchet = 68.0 (from the .ly \midi block).   #
#                                                                             #
#  Prepared for PJT, 2026-09-23.                                              #
###############################################################################

#include music.pch      # equal-tempered frequency symbols (_16 and _8 variants)
#include stdpard.pch    # ACT_MLEVEL, INFO_ML_*, MLT_PWM, PWM_PSC_* ...

# ---------------------------------------------------------------------------
# USER-ADJUSTABLE CONSTANTS (preprocessor substitutions, global scope)
# ---------------------------------------------------------------------------
#define BASS_PIN           9      # PWM pin on a 16-bit timer (Uno/Nano: 9 or 10; Mega: 2,3,5,6,7,8,11,12,44,45,46)
#define TREBLE_PIN         3      # PWM pin on the 8-bit timer  (Uno/Nano: 3;  Mega: 9)
#define STEP_SECONDS       0.2206 # duration of one semiquaver = 60 / (4 * 68.0 bpm)
#define ACT_SET_LATENCY    0.051  # seconds an act_set INFO_ML_LEVEL is assumed to take (subtracted from the sleep)
#define ARTICULATE_REPEATS 1      # 1 = separate repeated notes with a short rest, 0 = legato (repeats merge!)
#define ARTIC_GAP          0.020  # extra silence (s) inserted before a repeated note when ARTICULATE_REPEATS = 1
#define FERMATA_HOLD       1.50   # seconds the final chord is held beyond its written length
#define STARTING_POINT     0      # first step to play (0 = beginning; 16*(bar-1) starts at a given bar)
#define LAST_STEP          543    # index of the last step (544 steps in total)

# ---------------------------------------------------------------------------
# GLOBAL VARIABLES (PCS has global scope only; all defined up front)
# ---------------------------------------------------------------------------
def_var string actname1 _         # name of any pre-existing M-Level actuator 1
def_var string actname2 _         # name of any pre-existing M-Level actuator 2
def_var string msg _              # console messages
def_var int   step_idx 0          # current semiquaver step
def_var int   bass_ptr 0          # play-order value for the bass at this step
def_var int   treble_ptr 0        # play-order value for the treble at this step
def_var int   bass_sounding 0     # table row currently sounding on the bass (0 = nothing yet)
def_var int   treble_sounding 0   # table row currently sounding on the treble
def_var int   bass_retrig 0       # 1 when the bass must re-articulate a repeated note
def_var int   treble_retrig 0     # 1 when the treble must re-articulate a repeated note
def_var float sleep_time 0.0      # remaining wait for the current step
def_array int BassSeq 544 0       # play order, bass   (one entry per semiquaver)
def_array int TrebleSeq 544 0     # play order, treble (one entry per semiquaver)

# ---------------------------------------------------------------------------
# TRANSLATION-TABLE ROW ALIASES
#   Row 0 of each table is the "sustain" placeholder (frequency 0): a 0 in a
#   play-order array means "send nothing, let the note ring on".
#   The last row is the rest: a legal frequency with duty 0 %, which unhooks
#   the timer and forces the pin low (silence) whatever the frequency.
# ---------------------------------------------------------------------------
# BASS rows (16-bit timer, music.pch _16 symbols) - 29 pitches + rest
#define C2_NATL_B      1    # row  1 -> C2_NATL_16= 65 Hz (C2, MIDI 36)
#define D2_NATL_B      2    # row  2 -> D2_NATL_16= 73 Hz (D2, MIDI 38)
#define E2_FLAT_B      3    # row  3 -> E2_FLAT_16 = 78 Hz (Eb2, MIDI 39)
#define E2_NATL_B      4    # row  4 -> E2_NATL_16= 82 Hz (E2, MIDI 40)
#define F2_NATL_B      5    # row  5 -> F2_NATL_16= 87 Hz (F2, MIDI 41)
#define F2_SHRP_B      6    # row  6 -> F2_SHRP_16 = 93 Hz (F#2, MIDI 42)
#define G2_NATL_B      7    # row  7 -> G2_NATL_16= 98 Hz (G2, MIDI 43)
#define A2_FLAT_B      8    # row  8 -> A2_FLAT_16 = 104 Hz (Ab2, MIDI 44)
#define A2_NATL_B      9    # row  9 -> A2_NATL_16= 110 Hz (A2, MIDI 45)
#define B2_FLAT_B      10   # row 10 -> B2_FLAT_16 = 117 Hz (Bb2, MIDI 46)
#define B2_NATL_B      11   # row 11 -> B2_NATL_16= 123 Hz (B2, MIDI 47)
#define C3_NATL_B      12   # row 12 -> C3_NATL_16= 131 Hz (C3, MIDI 48)
#define C3_SHRP_B      13   # row 13 -> C3_SHRP_16 = 139 Hz (C#3, MIDI 49)
#define D3_NATL_B      14   # row 14 -> D3_NATL_16= 147 Hz (D3, MIDI 50)
#define E3_FLAT_B      15   # row 15 -> E3_FLAT_16 = 156 Hz (Eb3, MIDI 51)
#define E3_NATL_B      16   # row 16 -> E3_NATL_16= 165 Hz (E3, MIDI 52)
#define F3_NATL_B      17   # row 17 -> F3_NATL_16= 175 Hz (F3, MIDI 53)
#define F3_SHRP_B      18   # row 18 -> F3_SHRP_16 = 185 Hz (F#3, MIDI 54)
#define G3_NATL_B      19   # row 19 -> G3_NATL_16= 196 Hz (G3, MIDI 55)
#define A3_FLAT_B      20   # row 20 -> A3_FLAT_16 = 208 Hz (Ab3, MIDI 56)
#define A3_NATL_B      21   # row 21 -> A3_NATL_16= 220 Hz (A3, MIDI 57)
#define B3_FLAT_B      22   # row 22 -> B3_FLAT_16 = 233 Hz (Bb3, MIDI 58)
#define B3_NATL_B      23   # row 23 -> B3_NATL_16= 247 Hz (B3, MIDI 59)
#define C4_NATL_B      24   # row 24 -> C4_NATL_16= 262 Hz (C4, MIDI 60)
#define C4_SHRP_B      25   # row 25 -> C4_SHRP_16 = 277 Hz (C#4, MIDI 61)
#define D4_NATL_B      26   # row 26 -> D4_NATL_16= 294 Hz (D4, MIDI 62)
#define E4_FLAT_B      27   # row 27 -> E4_FLAT_16 = 311 Hz (Eb4, MIDI 63)
#define E4_NATL_B      28   # row 28 -> E4_NATL_16= 330 Hz (E4, MIDI 64)
#define F4_NATL_B      29   # row 29 -> F4_NATL_16= 349 Hz (F4, MIDI 65)
#define REST_B         30   # row 30 -> silence
# TREBLE rows (8-bit timer, music.pch _8 symbols) - 21 pitches + rest
#define C4_NATL_T      1    # row  1 -> C4_NATL_8= 262 Hz (C4, MIDI 60)
#define C4_SHRP_T      2    # row  2 -> C4_SHRP_8 = 277 Hz (C#4, MIDI 61)
#define D4_NATL_T      3    # row  3 -> D4_NATL_8= 294 Hz (D4, MIDI 62)
#define E4_FLAT_T      4    # row  4 -> E4_FLAT_8 = 311 Hz (Eb4, MIDI 63)
#define E4_NATL_T      5    # row  5 -> E4_NATL_8= 330 Hz (E4, MIDI 64)
#define F4_NATL_T      6    # row  6 -> F4_NATL_8= 349 Hz (F4, MIDI 65)
#define F4_SHRP_T      7    # row  7 -> F4_SHRP_8 = 370 Hz (F#4, MIDI 66)
#define G4_NATL_T      8    # row  8 -> G4_NATL_8= 392 Hz (G4, MIDI 67)
#define A4_FLAT_T      9    # row  9 -> A4_FLAT_8 = 415 Hz (Ab4, MIDI 68)
#define A4_NATL_T      10   # row 10 -> A4_NATL_8= 440 Hz (A4, MIDI 69)
#define B4_FLAT_T      11   # row 11 -> B4_FLAT_8 = 466 Hz (Bb4, MIDI 70)
#define B4_NATL_T      12   # row 12 -> B4_NATL_8= 494 Hz (B4, MIDI 71)
#define C5_NATL_T      13   # row 13 -> C5_NATL_8= 523 Hz (C5, MIDI 72)
#define D5_NATL_T      14   # row 14 -> D5_NATL_8= 587 Hz (D5, MIDI 74)
#define E5_FLAT_T      15   # row 15 -> E5_FLAT_8 = 622 Hz (Eb5, MIDI 75)
#define F5_NATL_T      16   # row 16 -> F5_NATL_8= 698 Hz (F5, MIDI 77)
#define F5_SHRP_T      17   # row 17 -> F5_SHRP_8 = 740 Hz (F#5, MIDI 78)
#define G5_NATL_T      18   # row 18 -> G5_NATL_8= 784 Hz (G5, MIDI 79)
#define A5_FLAT_T      19   # row 19 -> A5_FLAT_8 = 831 Hz (Ab5, MIDI 80)
#define A5_NATL_T      20   # row 20 -> A5_NATL_8= 880 Hz (A5, MIDI 81)
#define B5_FLAT_T      21   # row 21 -> B5_FLAT_8 = 932 Hz (Bb5, MIDI 82)
#define REST_T         22   # row 22 -> silence

def_func main
    set_str msg BWV 861 Fuga XVI - two-voice reduction - initialising actuators
    print_value msg 2
    get_actuators                 # refresh the local list of extant actuators

    # Safety layer (as in hu_BWV114.pcs): free any pre-existing M-Level
    # actuators with the index numbers we are about to use, whatever their
    # names, so that def_actuator cannot fail with a duplicate-index error.
    act_getname ACT_MLEVEL 1 actname1
    set_condexp actname1 != null
    do_if Condexp
        undef_actuator actname1
    enddo
    act_getname ACT_MLEVEL 2 actname2
    set_condexp actname2 != null
    do_if Condexp
        undef_actuator actname2
    enddo

    # 1. BASS voice: PWM M-Level actuator on a 16-bit timer, prescaler 8.
    #    The prescaler must be set BEFORE the pin is assigned (manual, act_set).
    def_actuator ACT_MLEVEL 1 ML_pwm1
    act_set ML_pwm1 INFO_ML_TYPE MLT_PWM
    act_set ML_pwm1 INFO_ML_PSC  PWM_PSC_8
    act_set ML_pwm1 INFO_PIN_P0  BASS_PIN

    # 2. TREBLE voice: PWM M-Level actuator on the 8-bit timer, prescaler 256.
    def_actuator ACT_MLEVEL 2 ML_pwm2
    act_set ML_pwm2 INFO_ML_TYPE MLT_PWM
    act_set ML_pwm2 INFO_ML_PSC  PWM_PSC_256
    act_set ML_pwm2 INFO_PIN_P0  TREBLE_PIN

    # =====================================================================
    # TRANSLATION TABLES (rows must be appended strictly in order from 0)
    # =====================================================================
    act_set ML_pwm1 INFO_ML_TTABLE 0 0 500                # row 0: sustain placeholder
    act_set ML_pwm1 INFO_ML_TTABLE 1   C2_NATL_16   500     # C2
    act_set ML_pwm1 INFO_ML_TTABLE 2   D2_NATL_16   500     # D2
    act_set ML_pwm1 INFO_ML_TTABLE 3   E2_FLAT_16   500     # Eb2
    act_set ML_pwm1 INFO_ML_TTABLE 4   E2_NATL_16   500     # E2
    act_set ML_pwm1 INFO_ML_TTABLE 5   F2_NATL_16   500     # F2
    act_set ML_pwm1 INFO_ML_TTABLE 6   F2_SHRP_16   500     # F#2
    act_set ML_pwm1 INFO_ML_TTABLE 7   G2_NATL_16   500     # G2
    act_set ML_pwm1 INFO_ML_TTABLE 8   A2_FLAT_16   500     # Ab2
    act_set ML_pwm1 INFO_ML_TTABLE 9   A2_NATL_16   500     # A2
    act_set ML_pwm1 INFO_ML_TTABLE 10  B2_FLAT_16   500     # Bb2
    act_set ML_pwm1 INFO_ML_TTABLE 11  B2_NATL_16   500     # B2
    act_set ML_pwm1 INFO_ML_TTABLE 12  C3_NATL_16   500     # C3
    act_set ML_pwm1 INFO_ML_TTABLE 13  C3_SHRP_16   500     # C#3
    act_set ML_pwm1 INFO_ML_TTABLE 14  D3_NATL_16   500     # D3
    act_set ML_pwm1 INFO_ML_TTABLE 15  E3_FLAT_16   500     # Eb3
    act_set ML_pwm1 INFO_ML_TTABLE 16  E3_NATL_16   500     # E3
    act_set ML_pwm1 INFO_ML_TTABLE 17  F3_NATL_16   500     # F3
    act_set ML_pwm1 INFO_ML_TTABLE 18  F3_SHRP_16   500     # F#3
    act_set ML_pwm1 INFO_ML_TTABLE 19  G3_NATL_16   500     # G3
    act_set ML_pwm1 INFO_ML_TTABLE 20  A3_FLAT_16   500     # Ab3
    act_set ML_pwm1 INFO_ML_TTABLE 21  A3_NATL_16   500     # A3
    act_set ML_pwm1 INFO_ML_TTABLE 22  B3_FLAT_16   500     # Bb3
    act_set ML_pwm1 INFO_ML_TTABLE 23  B3_NATL_16   500     # B3
    act_set ML_pwm1 INFO_ML_TTABLE 24  C4_NATL_16   500     # C4
    act_set ML_pwm1 INFO_ML_TTABLE 25  C4_SHRP_16   500     # C#4
    act_set ML_pwm1 INFO_ML_TTABLE 26  D4_NATL_16   500     # D4
    act_set ML_pwm1 INFO_ML_TTABLE 27  E4_FLAT_16   500     # Eb4
    act_set ML_pwm1 INFO_ML_TTABLE 28  E4_NATL_16   500     # E4
    act_set ML_pwm1 INFO_ML_TTABLE 29  F4_NATL_16   500     # F4
    act_set ML_pwm1 INFO_ML_TTABLE 30  C2_NATL_16   0      # rest (duty 0 = silence)

    act_set ML_pwm2 INFO_ML_TTABLE 0 0 500                # row 0: sustain placeholder
    act_set ML_pwm2 INFO_ML_TTABLE 1   C4_NATL_8    500     # C4
    act_set ML_pwm2 INFO_ML_TTABLE 2   C4_SHRP_8    500     # C#4
    act_set ML_pwm2 INFO_ML_TTABLE 3   D4_NATL_8    500     # D4
    act_set ML_pwm2 INFO_ML_TTABLE 4   E4_FLAT_8    500     # Eb4
    act_set ML_pwm2 INFO_ML_TTABLE 5   E4_NATL_8    500     # E4
    act_set ML_pwm2 INFO_ML_TTABLE 6   F4_NATL_8    500     # F4
    act_set ML_pwm2 INFO_ML_TTABLE 7   F4_SHRP_8    500     # F#4
    act_set ML_pwm2 INFO_ML_TTABLE 8   G4_NATL_8    500     # G4
    act_set ML_pwm2 INFO_ML_TTABLE 9   A4_FLAT_8    500     # Ab4
    act_set ML_pwm2 INFO_ML_TTABLE 10  A4_NATL_8    500     # A4
    act_set ML_pwm2 INFO_ML_TTABLE 11  B4_FLAT_8    500     # Bb4
    act_set ML_pwm2 INFO_ML_TTABLE 12  B4_NATL_8    500     # B4
    act_set ML_pwm2 INFO_ML_TTABLE 13  C5_NATL_8    500     # C5
    act_set ML_pwm2 INFO_ML_TTABLE 14  D5_NATL_8    500     # D5
    act_set ML_pwm2 INFO_ML_TTABLE 15  E5_FLAT_8    500     # Eb5
    act_set ML_pwm2 INFO_ML_TTABLE 16  F5_NATL_8    500     # F5
    act_set ML_pwm2 INFO_ML_TTABLE 17  F5_SHRP_8    500     # F#5
    act_set ML_pwm2 INFO_ML_TTABLE 18  G5_NATL_8    500     # G5
    act_set ML_pwm2 INFO_ML_TTABLE 19  A5_FLAT_8    500     # Ab5
    act_set ML_pwm2 INFO_ML_TTABLE 20  A5_NATL_8    500     # A5
    act_set ML_pwm2 INFO_ML_TTABLE 21  B5_FLAT_8    500     # Bb5
    act_set ML_pwm2 INFO_ML_TTABLE 22  C4_NATL_8    0      # rest (duty 0 = silence)

    # =====================================================================
    # PLAY ORDER: TrebleSeq  (treble actuator)
    #   value 0        = sustain (nothing sent)
    #   value 1..N     = note onset (translation-table row, see aliases)
    #   value REST_T   = rest onset
    #   The comment on each onset gives the note, the source voice
    #   (S = soprano, A = alto) and any editorial flag.
    # =====================================================================
    # ---- bar 1 ----
    set_var TrebleSeq[0] REST_T    # b1.1.1 rest
    set_var TrebleSeq[1] 0
    set_var TrebleSeq[2] 0
    set_var TrebleSeq[3] 0
    set_var TrebleSeq[4] 0
    set_var TrebleSeq[5] 0
    set_var TrebleSeq[6] 0
    set_var TrebleSeq[7] 0
    set_var TrebleSeq[8] 0
    set_var TrebleSeq[9] 0
    set_var TrebleSeq[10] 0
    set_var TrebleSeq[11] 0
    set_var TrebleSeq[12] 0
    set_var TrebleSeq[13] 0
    set_var TrebleSeq[14] 0
    set_var TrebleSeq[15] 0
    # ---- bar 2 ----
    set_var TrebleSeq[16] 0
    set_var TrebleSeq[17] 0
    set_var TrebleSeq[18] 0
    set_var TrebleSeq[19] 0
    set_var TrebleSeq[20] 0
    set_var TrebleSeq[21] 0
    set_var TrebleSeq[22] 0
    set_var TrebleSeq[23] 0
    set_var TrebleSeq[24] 0
    set_var TrebleSeq[25] 0
    set_var TrebleSeq[26] G4_NATL_T    # b2.3.3 G4 (S)
    set_var TrebleSeq[27] 0
    set_var TrebleSeq[28] B4_FLAT_T    # b2.4.1 Bb4 (S)
    set_var TrebleSeq[29] 0
    set_var TrebleSeq[30] D4_NATL_T    # b2.4.3 D4 (S)
    set_var TrebleSeq[31] 0
    # ---- bar 3 ----
    set_var TrebleSeq[32] C4_SHRP_T    # b3.1.1 C#4 (S)
    set_var TrebleSeq[33] 0
    set_var TrebleSeq[34] 0
    set_var TrebleSeq[35] 0
    set_var TrebleSeq[36] D4_NATL_T    # b3.2.1 D4 (S)
    set_var TrebleSeq[37] 0
    set_var TrebleSeq[38] 0
    set_var TrebleSeq[39] 0
    set_var TrebleSeq[40] REST_T    # b3.3.1 rest
    set_var TrebleSeq[41] 0
    set_var TrebleSeq[42] E4_NATL_T    # b3.3.3 E4 (S)
    set_var TrebleSeq[43] F4_NATL_T    # b3.3.4 F4 (S)
    set_var TrebleSeq[44] G4_NATL_T    # b3.4.1 G4 (S)
    set_var TrebleSeq[45] 0
    set_var TrebleSeq[46] F4_NATL_T    # b3.4.3 F4 (S)
    set_var TrebleSeq[47] E4_NATL_T    # b3.4.4 E4 (S)
    # ---- bar 4 ----
    set_var TrebleSeq[48] F4_NATL_T    # b4.1.1 F4 (S)
    set_var TrebleSeq[49] 0
    set_var TrebleSeq[50] G4_NATL_T    # b4.1.3 G4 (S)
    set_var TrebleSeq[51] A4_NATL_T    # b4.1.4 A4 (S)
    set_var TrebleSeq[52] B4_FLAT_T    # b4.2.1 Bb4 (S)
    set_var TrebleSeq[53] 0
    set_var TrebleSeq[54] A4_NATL_T    # b4.2.3 A4 (S)
    set_var TrebleSeq[55] G4_NATL_T    # b4.2.4 G4 (S)
    set_var TrebleSeq[56] A4_NATL_T    # b4.3.1 A4 (S)
    set_var TrebleSeq[57] 0
    set_var TrebleSeq[58] B4_FLAT_T    # b4.3.3 Bb4 (S)
    set_var TrebleSeq[59] C5_NATL_T    # b4.3.4 C5 (S)
    set_var TrebleSeq[60] D5_NATL_T    # b4.4.1 D5 (S)
    set_var TrebleSeq[61] 0
    set_var TrebleSeq[62] C5_NATL_T    # b4.4.3 C5 (S)
    set_var TrebleSeq[63] B4_FLAT_T    # b4.4.4 Bb4 (S)
    # ---- bar 5 ----
    set_var TrebleSeq[64] C5_NATL_T    # b5.1.1 C5 (S)
    set_var TrebleSeq[65] 0
    set_var TrebleSeq[66] 0
    set_var TrebleSeq[67] 0
    set_var TrebleSeq[68] B4_FLAT_T    # b5.2.1 Bb4 (S)
    set_var TrebleSeq[69] 0
    set_var TrebleSeq[70] 0
    set_var TrebleSeq[71] 0
    set_var TrebleSeq[72] A4_NATL_T    # b5.3.1 A4 (S)
    set_var TrebleSeq[73] 0
    set_var TrebleSeq[74] D5_NATL_T    # b5.3.3 D5 (S)
    set_var TrebleSeq[75] C5_NATL_T    # b5.3.4 C5 (S)
    set_var TrebleSeq[76] B4_FLAT_T    # b5.4.1 Bb4 (S)
    set_var TrebleSeq[77] 0
    set_var TrebleSeq[78] C5_NATL_T    # b5.4.3 C5 (S)
    set_var TrebleSeq[79] D5_NATL_T    # b5.4.4 D5 (S)
    # ---- bar 6 ----
    set_var TrebleSeq[80] E5_FLAT_T    # b6.1.1 Eb5 (S)
    set_var TrebleSeq[81] 0
    set_var TrebleSeq[82] C5_NATL_T    # b6.1.3 C5 (S)
    set_var TrebleSeq[83] 0
    set_var TrebleSeq[84] A4_NATL_T    # b6.2.1 A4 (S)
    set_var TrebleSeq[85] 0
    set_var TrebleSeq[86] F5_SHRP_T    # b6.2.3 F#5 (S)
    set_var TrebleSeq[87] 0
    set_var TrebleSeq[88] G5_NATL_T    # b6.3.1 G5 (S)
    set_var TrebleSeq[89] 0
    set_var TrebleSeq[90] 0
    set_var TrebleSeq[91] 0
    set_var TrebleSeq[92] REST_T    # b6.4.1 rest
    set_var TrebleSeq[93] 0
    set_var TrebleSeq[94] 0
    set_var TrebleSeq[95] 0
    # ---- bar 7 ----
    set_var TrebleSeq[96] 0
    set_var TrebleSeq[97] 0
    set_var TrebleSeq[98] E4_NATL_T    # b7.1.3 E4 (S)
    set_var TrebleSeq[99] 0
    set_var TrebleSeq[100] A4_NATL_T    # b7.2.1 A4 (S)
    set_var TrebleSeq[101] 0
    set_var TrebleSeq[102] F4_NATL_T    # b7.2.3 F4 (S)
    set_var TrebleSeq[103] 0
    set_var TrebleSeq[104] D4_NATL_T    # b7.3.1 D4 (S)
    set_var TrebleSeq[105] 0
    set_var TrebleSeq[106] 0
    set_var TrebleSeq[107] 0
    set_var TrebleSeq[108] C4_SHRP_T    # b7.4.1 C#4 (S)
    set_var TrebleSeq[109] 0
    set_var TrebleSeq[110] E4_NATL_T    # b7.4.3 E4 (S)
    set_var TrebleSeq[111] 0
    # ---- bar 8 ----
    set_var TrebleSeq[112] 0
    set_var TrebleSeq[113] 0
    set_var TrebleSeq[114] D4_NATL_T    # b8.1.3 D4 (S)
    set_var TrebleSeq[115] 0
    set_var TrebleSeq[116] G4_NATL_T    # b8.2.1 G4 (S)
    set_var TrebleSeq[117] 0
    set_var TrebleSeq[118] 0
    set_var TrebleSeq[119] 0
    set_var TrebleSeq[120] 0
    set_var TrebleSeq[121] F4_SHRP_T    # b8.3.2 F#4 (S)
    set_var TrebleSeq[122] G4_NATL_T    # b8.3.3 G4 (S)
    set_var TrebleSeq[123] A4_NATL_T    # b8.3.4 A4 (S)
    set_var TrebleSeq[124] B4_FLAT_T    # b8.4.1 Bb4 (S)
    set_var TrebleSeq[125] 0
    set_var TrebleSeq[126] 0
    set_var TrebleSeq[127] 0
    # ---- bar 9 ----
    set_var TrebleSeq[128] 0
    set_var TrebleSeq[129] 0
