Pardus pcs 1
verbosity 1
gui_update_period 17 # Keep the GUI alive briefly so the 'Interrupt' button renders

# Local Polyphonic Arrangement of "Minuet in G Major" (BWV Anh. 114)
# Plays locally via polyphonic beep (no pardserver connection required)

#include music.pch

# --- BASS INDEX DEFINITIONS ---
#define G2_NATL_B  1
