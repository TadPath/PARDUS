 set_var step_idx 0
 set_condexp step_idx <= 191
 gui_update_period 0 # Full timing precision during playback

 loop_while Condexp

    # --- Voice 1: BASS ---
    set_var target_bass_ptr BassSeq[step_idx]
    set_var current_pitch1 BassFreq[target_bass_ptr]
    set_condexp current_pitch1 > 0.0
    do_if Condexp
      # Count consecutive 0 sustain slots ahead of this note
      set_var hold_steps 1
      set_var scan_idx step_idx
      add_var scan_idx 1
      set_var loop_active 1
      loop_while loop_active
        set_condexp scan_idx <= 191
        do_if Condexp
          set_var next_ptr BassSeq[scan_idx]
          set_condexp next_ptr == 0
          do_if Condexp
            add_var hold_steps 1
            add_var scan_idx 1
          enddo
          set_condexp next_ptr != 0
          do_if Condexp
            set_var loop_active 0
          enddo
        enddo
        set_condexp scan_idx > 191
        do_if Condexp
          set_var loop_active 0
        enddo
      endloop

      # Calculate total legato duration in ms (175 ms/step minus 10 ms articulation gap)
      set_var note_ms hold_steps
      mul_var note_ms 175
      sub_var note_ms 10
      beep note_ms current_pitch1 bass_vol
    enddo

    # --- Voice 2: TREBLE ---
    set_var target_treble_ptr TrebleSeq[step_idx]
    set_var current_pitch2 TrebleFreq[target_treble_ptr]
    set_condexp current_pitch2 > 0.0
    do_if Condexp
      # Count consecutive 0 sustain slots ahead of this note
      set_var hold_steps 1
      set_var scan_idx step_idx
      add_var scan_idx 1
      set_var loop_active 1
      loop_while loop_active
        set_condexp scan_idx <= 191
        do_if Condexp
          set_var next_ptr TrebleSeq[scan_idx]
          set_condexp next_ptr == 0
          do_if Condexp
            add_var hold_steps 1
            add_var scan_idx 1
          enddo
          set_condexp next_ptr != 0
          do_if Condexp
            set_var loop_active 0
          enddo
        enddo
        set_condexp scan_idx > 191
        do_if Condexp
          set_var loop_active 0
        enddo
      endloop
      # Calculate total legato duration in ms (175 ms/step minus 10 ms articulation gap)
      set_var note_ms hold_steps
      mul_var note_ms 175
      sub_var note_ms 10
      beep note_ms current_pitch2 treble_vol
    enddo

    # Pace the 1/8th-note subdivision grid
    sleep step_secs
    add_var step_idx 1
    set_condexp step_idx <= 191

 endloop

 # Allow the final sustained notes (M32) to finish ringing cleanly
 sleep 1.1

return

exit
