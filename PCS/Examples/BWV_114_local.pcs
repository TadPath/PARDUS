    set_var TrebleFreq[4]  B5_NATL
    set_var TrebleFreq[5]  C6_NATL
    set_var TrebleFreq[6]  E6_NATL
    set_var TrebleFreq[7]  F6_SHRP
    set_var TrebleFreq[8]  G6_NATL
    set_var TrebleFreq[9]  F5_SHRP
    set_var TrebleFreq[10] F5_NATL
    set_var TrebleFreq[11] E5_NATL
    set_var TrebleFreq[12] D5_NATL
    set_var TrebleFreq[13] C5_NATL
    set_var TrebleFreq[14] A4_NATL
