#define C6_SHRP_T  17

# --- GLOBAL VARIABLES ---
def_var float current_pitch1 0.0
def_var float current_pitch2 0.0
def_var int step_idx 0
def_var int scan_idx 0
def_var int hold_steps 1
def_var int note_ms 165
def_var int target_bass_ptr 0
def_var int target_treble_ptr 0
def_var int next_ptr 0
def_var int loop_active 1
def_var float step_secs 0.175

# Voice balance (0-100%)
def_var int bass_vol 100
def_var int treble_vol 75

def_func main

    # =====================================================================
    # FLOATING-POINT FREQUENCY LOOKUP TABLES (Exact Pitches from music.pch)
    # =====================================================================
    def_array float BassFreq 23 0.0
    set_var BassFreq[0]  0.0          # Sustain
    set_var BassFreq[1]  G2_NATL
    set_var BassFreq[2]  B2_NATL
    set_var BassFreq[3]  C3_NATL
    set_var BassFreq[4]  D3_NATL
    set_var BassFreq[5]  A2_NATL
    set_var BassFreq[6]  F3_SHRP
    set_var BassFreq[7]  G3_NATL
