#define C3_NATL_B  3
#define D3_NATL_B  4
#define A2_NATL_B  5
#define F3_SHRP_B  6
#define G3_NATL_B  7
#define A3_NATL_B  8
#define C4_NATL_B  9
#define B3_NATL_B  10
#define F2_SHRP_B  11
#define E2_NATL_B  12
#define F2_NATL_B  13
#define E3_NATL_B  14
#define C2_NATL_B  15
#define G3_SHRP_B  16
#define D2_NATL_B  17
#define G1_NATL_B  18
#define A1_NATL_B  19
#define B1_NATL_B  20
#define C3_SHRP_B  21
#define REST_B     22

# --- TREBLE INDEX DEFINITIONS ---
#define D6_NATL_T  1
#define G5_NATL_T  2
