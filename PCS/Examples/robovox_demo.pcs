    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_TH
    set_var rv_seq[2] to_P6
    set_var rv_seq[3] say_AE
    set_var rv_seq[4] pitch_P5
    set_var rv_seq[5] say_NG
    set_var rv_seq[6] say_K
    set_var rv_seq[7] pitch_P4
    set_var rv_seq[8] UNSTR
    set_var rv_seq[9] say_Y
    set_var rv_seq[10] say_UU
    set_var rv_seq_len 11
