    set_var rv_seq[2] say_D
    set_var rv_seq[3] pitch_P8
    set_var rv_seq[4] UNSTR
    set_var rv_seq[5] say_W
    set_var rv_seq[6] pitch_P9
    set_var rv_seq[7] to_P6
    set_var rv_seq[8] say_EE
    set_var rv_seq[9] pitch_P5
    set_var rv_seq[10] say_N
    set_var rv_seq[11] pitch_P4
    set_var rv_seq[12] say_OU
