finished:
    call_func rv_finish
return


exit
###############################################################################
# Scratchpad: the transcriptions
#   HELLO              pitch_P7 H UNSTR EH pitch_P8 L pitch_P7 FINAL to_P4 OU
#   HELLO_WORLD        pitch_P7 H UNSTR EH pitch_P10 L to_P9 OU PAUSE W pitch_P8 FINAL to_P4 ER L D
#   ROBOT              pitch_P9 R to_P7 OU pitch_P5 B to_P4 OH T
#   PARDUS             pitch_P8 P UNSTR AH UNSTR R pitch_P4 D AX S
#   YES                pitch_P7 Y FINAL to_P4 EH S
#   NO                 pitch_P6 LONG N FINAL to_P4 OU
#   EARLY              pitch_P7 to_P6 UNSTR ER UNSTR R UNSTR L EE
#   ONE_TWO_THREE      pitch_P8 W to_P5 UH pitch_P6 N GAP pitch_P5 T to_P7 UU GAP pitch_P7 TH pitch_P9 UNSTR R FINAL to_P4 EE
#   I_AM_A_ROBOT       pitch_P8 AY UNSTR AE LONG M pitch_P7 UNSTR UH pitch_P9 R to_P6 OU pitch_P5 B to_P4 OH T
#   GOOD_MORNING       pitch_P8 G OO D pitch_P7 M pitch_P6 to_P5 AW pitch_P4 N IH pitch_P4 NG
#   COMPUTER           pitch_P8 K AX M P pitch_P9 Y to_P7 UU T pitch_P5 FINAL to_P4 AX
#   ARDUINO            pitch_P7 AH D pitch_P8 UNSTR W pitch_P9 to_P6 EE pitch_P5 N pitch_P4 OU
#   THANK_YOU          pitch_P8 TH to_P6 AE pitch_P5 NG K pitch_P4 UNSTR Y UU
#   ROBOVOX            pitch_P9 R to_P7 OU pitch_P5 B UNSTR OU V pitch_P4 OH K S
#   THANK_YOU_DARK_TH  pitch_P8 THD to_P6 AE pitch_P5 NG K pitch_P4 UNSTR Y UU
###############################################################################
