Pardus pcs 1
add_lib robovox_lib.pcl
verbosity 1
gui_update_period 0 

###############################################################################
#  robovox_demo.pcs  --  the menu of words and sentences (iteration 7p5,      #
#  final)                                                                     #
#  Type the number of a word (or q to quit) in the pardclient entry box;      #
#  r toggles the FASTER tempo (the default is the normal one).  Each word     #
#  is a string array of functions.  Item 15 is THANK YOU with the darker 'th'.#
#  Generated by rv_generate7.py (ROBOVOX iteration 7, the final one).         #
#  Prepared for the PJT.                                                      #
#  FIRMWARE: parduino_fixed11 (the PJT's own; clean onsets).  Driver:         #
#  ROBOVOX_Circuits.                                                          #
#  LIBRARY: robovox7_lib.pcl, made ONCE from robovox7_lib.pcs (load it, press #
#  Run).                                                                      #
###############################################################################

#include stdpard.pch
#include robovox.pch

def_var string rv_label _        # goto label built from the menu choice

def_func main
    call_func rv_init
    print_clear
menu:
    gui_update_period 17          # a responsive GUI while waiting for input
    call_func rv_finish           # silence while idle
set_str rv_msg ROBOVOX 7 menu -- type a number then Return (q quits):
    print_value rv_msg 2
    set_str rv_msg    1 : HELLO
    print_value rv_msg 2
    set_str rv_msg    2 : HELLO WORLD
    print_value rv_msg 2
    set_str rv_msg    3 : ROBOT
    print_value rv_msg 2
    set_str rv_msg    4 : PARDUS
    print_value rv_msg 2
    set_str rv_msg    5 : YES
    print_value rv_msg 2
    set_str rv_msg    6 : NO
    print_value rv_msg 2
    set_str rv_msg    7 : EARLY
    print_value rv_msg 2
    set_str rv_msg    8 : ONE TWO THREE
    print_value rv_msg 2
    set_str rv_msg    9 : I AM A ROBOT
    print_value rv_msg 2
    set_str rv_msg   10 : GOOD MORNING
    print_value rv_msg 2
    set_str rv_msg   11 : COMPUTER
    print_value rv_msg 2
    set_str rv_msg   12 : ARDUINO
    print_value rv_msg 2
    set_str rv_msg   13 : THANK YOU
    print_value rv_msg 2
    set_str rv_msg   14 : ROBOVOX
    print_value rv_msg 2
    set_str rv_msg   15 : THANK YOU with the darker 'th' (say_THD)
    print_value rv_msg 2
    set_str rv_msg   r : toggle the faster tempo (RV_FAST_RATE; the default is the normal tempo)
    print_value rv_msg 2
    poll_user ON ON rv_msg
    set_condexp rv_msg == q
    goto finished if Condexp
    set_condexp rv_msg == r
    do_if Condexp
        set_condexp rv_rate < 0.9
        do_if Condexp
            set_var rv_rate 1.0
        else
            set_var rv_rate RV_FAST_RATE
        enddo
        goto menu
    enddo
    # Build the goto label word_<n> from the typed text (a string is a label)
    set_str rv_label word_
    add_var rv_label rv_msg
    gui_update_period 0
    set_condexp rv_label == word_1
    goto word_1 if Condexp
    set_condexp rv_label == word_2
    goto word_2 if Condexp
    set_condexp rv_label == word_3
    goto word_3 if Condexp
    set_condexp rv_label == word_4
    goto word_4 if Condexp
    set_condexp rv_label == word_5
    goto word_5 if Condexp
    set_condexp rv_label == word_6
    goto word_6 if Condexp
    set_condexp rv_label == word_7
    goto word_7 if Condexp
    set_condexp rv_label == word_8
    goto word_8 if Condexp
    set_condexp rv_label == word_9
    goto word_9 if Condexp
    set_condexp rv_label == word_10
    goto word_10 if Condexp
    set_condexp rv_label == word_11
    goto word_11 if Condexp
    set_condexp rv_label == word_12
    goto word_12 if Condexp
    set_condexp rv_label == word_13
    goto word_13 if Condexp
    set_condexp rv_label == word_14
    goto word_14 if Condexp
    set_condexp rv_label == word_15
    goto word_15 if Condexp
    set_str rv_msg That number is not on the menu. Try again.
    print_value rv_msg 2
    goto menu
word_1:
    set_str rv_msg Saying: HELLO
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P7
    set_var rv_seq[1] say_H
    set_var rv_seq[2] UNSTR
    set_var rv_seq[3] say_EH
    set_var rv_seq[4] pitch_P8
    set_var rv_seq[5] say_L
    set_var rv_seq[6] pitch_P7
    set_var rv_seq[7] FINAL
    set_var rv_seq[8] to_P4
    set_var rv_seq[9] say_OU
    set_var rv_seq_len 10
    call_func rv_speak
    call_func say_GAP
    goto menu
word_2:
    set_str rv_msg Saying: HELLO WORLD
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P7
    set_var rv_seq[1] say_H
    set_var rv_seq[2] UNSTR
    set_var rv_seq[3] say_EH
    set_var rv_seq[4] pitch_P10
    set_var rv_seq[5] say_L
    set_var rv_seq[6] to_P9
    set_var rv_seq[7] say_OU
    set_var rv_seq[8] say_PAUSE
    set_var rv_seq[9] say_W
    set_var rv_seq[10] pitch_P8
    set_var rv_seq[11] FINAL
    set_var rv_seq[12] to_P4
    set_var rv_seq[13] say_ER
    set_var rv_seq[14] say_L
    set_var rv_seq[15] say_D
    set_var rv_seq_len 16
    call_func rv_speak
    call_func say_GAP
    goto menu
word_3:
    set_str rv_msg Saying: ROBOT
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P9
    set_var rv_seq[1] say_R
    set_var rv_seq[2] to_P7
    set_var rv_seq[3] say_OU
    set_var rv_seq[4] pitch_P5
    set_var rv_seq[5] say_B
    set_var rv_seq[6] to_P4
    set_var rv_seq[7] say_OH
    set_var rv_seq[8] say_T
    set_var rv_seq_len 9
    call_func rv_speak
    call_func say_GAP
    goto menu
word_4:
    set_str rv_msg Saying: PARDUS
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_P
    set_var rv_seq[2] UNSTR
    set_var rv_seq[3] say_AH
    set_var rv_seq[4] UNSTR
    set_var rv_seq[5] say_R
    set_var rv_seq[6] pitch_P4
    set_var rv_seq[7] say_D
    set_var rv_seq[8] say_AX
    set_var rv_seq[9] say_S
    set_var rv_seq_len 10
    call_func rv_speak
    call_func say_GAP
    goto menu
word_5:
    set_str rv_msg Saying: YES
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P7
    set_var rv_seq[1] say_Y
    set_var rv_seq[2] FINAL
    set_var rv_seq[3] to_P4
    set_var rv_seq[4] say_EH
    set_var rv_seq[5] say_S
    set_var rv_seq_len 6
    call_func rv_speak
    call_func say_GAP
    goto menu
word_6:
    set_str rv_msg Saying: NO
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P6
    set_var rv_seq[1] LONG
    set_var rv_seq[2] say_N
    set_var rv_seq[3] FINAL
    set_var rv_seq[4] to_P4
    set_var rv_seq[5] say_OU
    set_var rv_seq_len 6
    call_func rv_speak
    call_func say_GAP
    goto menu
word_7:
    set_str rv_msg Saying: EARLY
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P7
    set_var rv_seq[1] to_P6
    set_var rv_seq[2] UNSTR
    set_var rv_seq[3] say_ER
    set_var rv_seq[4] UNSTR
    set_var rv_seq[5] say_R
    set_var rv_seq[6] UNSTR
    set_var rv_seq[7] say_L
    set_var rv_seq[8] say_EE
    set_var rv_seq_len 9
    call_func rv_speak
    call_func say_GAP
    goto menu
word_8:
    set_str rv_msg Saying: ONE TWO THREE
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_W
    set_var rv_seq[2] to_P5
    set_var rv_seq[3] say_UH
    set_var rv_seq[4] pitch_P6
    set_var rv_seq[5] say_N
    set_var rv_seq[6] say_GAP
    set_var rv_seq[7] pitch_P5
    set_var rv_seq[8] say_T
    set_var rv_seq[9] to_P7
    set_var rv_seq[10] say_UU
    set_var rv_seq[11] say_GAP
    set_var rv_seq[12] pitch_P7
    set_var rv_seq[13] say_TH
    set_var rv_seq[14] pitch_P9
    set_var rv_seq[15] UNSTR
    set_var rv_seq[16] say_R
    set_var rv_seq[17] FINAL
    set_var rv_seq[18] to_P4
    set_var rv_seq[19] say_EE
    set_var rv_seq_len 20
    call_func rv_speak
    call_func say_GAP
    goto menu
word_9:
    set_str rv_msg Saying: I AM A ROBOT
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_AY
    set_var rv_seq[2] UNSTR
    set_var rv_seq[3] say_AE
    set_var rv_seq[4] LONG
    set_var rv_seq[5] say_M
    set_var rv_seq[6] pitch_P7
    set_var rv_seq[7] UNSTR
    set_var rv_seq[8] say_UH
    set_var rv_seq[9] pitch_P9
    set_var rv_seq[10] say_R
    set_var rv_seq[11] to_P6
    set_var rv_seq[12] say_OU
    set_var rv_seq[13] pitch_P5
    set_var rv_seq[14] say_B
    set_var rv_seq[15] to_P4
    set_var rv_seq[16] say_OH
    set_var rv_seq[17] say_T
    set_var rv_seq_len 18
    call_func rv_speak
    call_func say_GAP
    goto menu
word_10:
    set_str rv_msg Saying: GOOD MORNING
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_G
    set_var rv_seq[2] say_OO
    set_var rv_seq[3] say_D
    set_var rv_seq[4] pitch_P7
    set_var rv_seq[5] say_M
    set_var rv_seq[6] pitch_P6
    set_var rv_seq[7] to_P5
    set_var rv_seq[8] say_AW
    set_var rv_seq[9] pitch_P4
    set_var rv_seq[10] say_N
    set_var rv_seq[11] say_IH
    set_var rv_seq[12] pitch_P4
    set_var rv_seq[13] say_NG
    set_var rv_seq_len 14
    call_func rv_speak
    call_func say_GAP
    goto menu
word_11:
    set_str rv_msg Saying: COMPUTER
    print_value rv_msg 2
    set_var rv_seq[0] pitch_P8
    set_var rv_seq[1] say_K
    set_var rv_seq[2] say_AX
    set_var rv_seq[3] say_M
    set_var rv_seq[4] say_P
    set_var rv_seq[5] pitch_P9
    set_var rv_seq[6] say_Y
    set_var rv_seq[7] to_P7
    set_var rv_seq[8] say_UU
    set_var rv_seq[9] say_T
    set_var rv_seq[10] pitch_P5
    set_var rv_seq[11] FINAL
    set_var rv_seq[12] to_P4
