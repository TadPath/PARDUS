    # 'sh': a continuous 16 kHz noise of 15.5 us pulses (soft attack), voice silent
    set_var rv_t RV_DUR_SH
    set_var rv_nrow RV_NSH
    call_func rv_noise_set
    set_var rv_row RV_SIL
    call_func rv_voice_only
