    set_var rv_pitch 11
return
def_func to_P0
    # the next vowel ends at level 0 (69 Hz): a glide within it
    set_var rv_p2 0
    set_var rv_tgt 1
return
def_func to_P1
    # the next vowel ends at level 1 (73 Hz): a glide within it
    set_var rv_p2 1
    set_var rv_tgt 1
return
def_func to_P2
    # the next vowel ends at level 2 (78 Hz): a glide within it
    set_var rv_p2 2
    set_var rv_tgt 1
return
def_func to_P3
    # the next vowel ends at level 3 (82 Hz): a glide within it
    set_var rv_p2 3
    set_var rv_tgt 1
return
def_func to_P4
    # the next vowel ends at level 4 (87 Hz): a glide within it
    set_var rv_p2 4
    set_var rv_tgt 1
return
def_func to_P5
    # the next vowel ends at level 5 (92 Hz): a glide within it
    set_var rv_p2 5
    set_var rv_tgt 1
return
def_func to_P6
    # the next vowel ends at level 6 (98 Hz): a glide within it
    set_var rv_p2 6
    set_var rv_tgt 1
return
def_func to_P7
    # the next vowel ends at level 7 (103 Hz): a glide within it
    set_var rv_p2 7
    set_var rv_tgt 1
return
def_func to_P8
    # the next vowel ends at level 8 (110 Hz): a glide within it
    set_var rv_p2 8
    set_var rv_tgt 1
return
def_func to_P9
    # the next vowel ends at level 9 (116 Hz): a glide within it
    set_var rv_p2 9
