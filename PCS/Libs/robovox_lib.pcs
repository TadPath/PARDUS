def_func say_TH
    # 'th' (thin): timed hiss (4 us pulses, 99 ms)  [iteration 6: one class louder]
    set_var rv_t RV_DUR_TH
    set_var rv_nrow RV_NTH
    call_func rv_burst
    set_var rv_row RV_SIL
    call_func rv_voice_only
    call_func rv_wait
return
def_func say_THD
    # 'th', DARKER (iteration 7, say_THD): a 2.5 kHz clock of 6 us pulses, 99 ms: the darkest row at the level of say_TH (centroid 11 % lower; tests/t44_dark_th.py)
    set_var rv_t RV_DUR_TH
    set_var rv_nrow RV_NTHD
    call_func rv_burst
    set_var rv_row RV_SIL
    call_func rv_voice_only
    call_func rv_wait
return
def_func say_DH
    # 'th' (this): the 'th' hiss over the voice bar
    set_var rv_t RV_DUR_DH
    set_var rv_nrow RV_NTH
    call_func rv_burst
    set_var rv_row RV_VB
    add_var rv_row rv_pitch
    call_func rv_voice_only
    call_func rv_wait
return
def_func say_CH
    # 'ch': silence, then a burst running into the 'sh' noise
    set_var rv_t RV_DUR_CLOSURE_VL
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_CH
    set_var rv_nrow RV_NCH
    call_func rv_noise_set
    call_func rv_wait
return
def_func say_J
    # 'j' (judge): the voice bar, then the burst and 'sh' noise over it
    set_var rv_t RV_DUR_CLOSURE_V
    set_var rv_row RV_VB
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_CH
    set_var rv_nrow RV_NCH
    call_func rv_noise_set
    call_func rv_wait
return
def_func say_X
    # 'x' = k s
    call_func say_K
    call_func say_S
return
def_func rv_speak
    # Play the function names stored in rv_seq[0 .. rv_seq_len-1].
    set_var rv_i 0
    set_condexp rv_i < rv_seq_len
    loop_while Condexp
        call_func rv_seq[rv_i]
        add_var rv_i 1
        set_condexp rv_i < rv_seq_len
    endloop
return
exit
