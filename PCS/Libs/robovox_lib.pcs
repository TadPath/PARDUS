def_func say_L
    # 'l': the l colour at the current pitch (the voice glides into and out of it)
    set_var rv_t RV_DUR_LL
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_LL
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_M
    # nasal murmur: a pulse of about 31 us (26 to 37 us as the per-mille steps realise it at
    # the twelve pitch levels; 34 us at the floor), held 0.15 s (RV_DUR_NN, equal to RV_DUR_NM);
    # the next vowel glides out of it  [label]
    set_var rv_t RV_DUR_NN
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_NM
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_N
    # nasal murmur: a pulse of about 31 us (26 to 37 us as the per-mille steps realise it at
    # the twelve pitch levels; 34 us at the floor), held 0.15 s (RV_DUR_NN, equal to RV_DUR_NM);
    # the next vowel glides out of it  [label]
    set_var rv_t RV_DUR_NN
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_NM
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_NG
    # 'ng' (thank, morning): the murmur (about 31 us) for 55 % of its time, then it decays to
    # the voice bar (about 15 us; 10 to 19 us as realised; 11 us at the floor), as a final nasal fades
    set_var rv_t RV_DUR_NG
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_half rv_t
    mul_var rv_half 0.45
    sub_var rv_t rv_half
    set_var rv_row RV_NM
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t rv_half
    set_var rv_row RV_VB
    add_var rv_row rv_pitch
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_W
    # 'w': 'uu' (2308 us, the darkest shape) held 0.12 s, from which the next vowel walks over
    # 150 ms (RV_G_WY)  [iteration 6: was 'oo' (923 us) for 0.18 s]
    set_var rv_t RV_DUR_W
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_UU
    add_var rv_row rv_pitch
    call_func rv_voice_set
    set_var rv_grow RV_G_WY
    call_func rv_glide_set
    set_var rv_wy 1
    call_func rv_wait
return
def_func say_Y
    # 'y': 'ee' (1231 us) held, from which the next vowel walks over 150 ms (RV_G_WY)
    set_var rv_t RV_DUR_Y
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_EE
    add_var rv_row rv_pitch
    call_func rv_voice_set
    set_var rv_grow RV_G_WY
    call_func rv_glide_set
    set_var rv_wy 1
    call_func rv_wait
return
def_func say_RX
    # tapped 'r': one order of the trill
    set_var rv_t RV_DUR_RX
    set_var rv_row RV_RR
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_R
    # trilled 'rr': 28 clicks per second, held RV_DUR_RR = 0.117 s (iteration 7p5: 3/4 of iteration
    # 6's 0.156 s, his task 3), then the next vowel's 40 ms glide out of it adds two or three clicks:
    # four to five clicks as heard when stressed, three unstressed  [evidence: his own cuts]
    set_var rv_t RV_DUR_RR
    mul_var rv_t rv_rate
    mul_var rv_t rv_dmul
    set_var rv_dmul 1.0
    set_var rv_row RV_RR
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_H
    # 'h' (iteration 7): a CONTINUOUS hiss (RV_NHC: 4 us pulses at 16 kHz, soft attack), then, one
    # round trip later, the VOICE BAR (nominally 15 us; 11 us at the floor, 19 us at P7) at the current pitch under it, so that the next
    # vowel WALKS OUT OF THE BAR over the default glide (40 ms) instead of starting with a whole
    # first pulse of the square wave (his 'h[b]alow', 26.10.2026: the step of the cone, a thump).
    # The vowel comes RV_DUR_H = 0.103 s after the hiss order; its rv_voice_set switches the hiss
    # off one round trip after its own order, so the hiss covers the whole walk (iteration 6: the
    # timed hiss ended 23 ms into the vowel).  From silence the bar is a quiet pulse train under
    # the hiss; from a vowel the voice walks down to it.  [evidence: his comment; tests/t45_h_onset.py]
    set_var rv_t RV_DUR_H
    set_var rv_nrow RV_NHC
    call_func rv_noise_set
    set_var rv_row RV_VB
    add_var rv_row rv_pitch
    call_func rv_voice_only
    call_func rv_wait
return
def_func say_H6
    # 'h' of iteration 6: the hiss, the voice silent under it; the vowel's order comes 60 ms
    # after the hiss order and its whole first pulse 1.5 periods later (the hiss overlaps its
    # first 13 to 23 ms).  Kept for comparison: heard as 'h[b]' before 'eh'.
    set_var rv_t RV_DUR_H6
    set_var rv_nrow RV_NH
    call_func rv_burst
    set_var rv_row RV_SIL
    call_func rv_voice_only
    call_func rv_wait
return
def_func say_P
    # 'p': silence (closure), then a timed burst that ends by itself; the vowel begins one round
    # trip after the burst order (an aspirated release).  After a silence or a voiceless sound
    # the softer burst RV_BPI (iteration 7: class 4, 15.6 us, one class louder than iteration 6's:
    # 'a little bit too weak'), between voiced sounds iteration 3's RV_BP (COMPUTER: 'Very good')
    set_var rv_nrow RV_BP
    set_condexp rv_sounding == RV_SIL
    do_if Condexp
        set_var rv_nrow RV_BPI
    enddo
    set_var rv_t RV_DUR_CLOSURE_VL
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    call_func rv_burst
    call_func rv_wait
return
def_func say_PS
    # 'p' with the softer burst RV_BPI everywhere, also between voiced sounds (calibration 6,
    # pair 14: the soft 'p' preferred in COMPUTER; offered as an alternative to say_P)
    set_var rv_t RV_DUR_CLOSURE_VL
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BPI
    call_func rv_burst
    call_func rv_wait
return
def_func say_T
    # 't': silence (closure), then a timed burst that ends by itself; the vowel
    # begins one round trip after the burst order (an aspirated release)
    set_var rv_t RV_DUR_CLOSURE_VL
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BT
    call_func rv_burst
    call_func rv_wait
return
def_func say_K
    # 'k': silence (closure), then a timed burst that ends by itself; the vowel
    # begins one round trip after the burst order (an aspirated release)
    set_var rv_t RV_DUR_CLOSURE_VL
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BK
    call_func rv_burst
    call_func rv_wait
return
def_func say_B
    # 'b': the closure -- the voice bar when the voice is sounding before it (between
    # voiced sounds), silence after a silence (iteration 5: the bar alone was heard as a
    # nasal, 'ngood') -- then the burst; the next vowel glides out of the closure
    set_var rv_t RV_DUR_CLOSURE_V
    set_condexp rv_sounding == RV_SIL
    do_if Condexp
        set_var rv_row RV_SIL
    else
        set_var rv_row RV_VB
        add_var rv_row rv_pitch
    enddo
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BB
    call_func rv_burst
    call_func rv_wait
return
def_func say_D
    # 'd': the closure -- the voice bar when the voice is sounding before it (between
    # voiced sounds), silence after a silence (iteration 5: the bar alone was heard as a
    # nasal, 'ngood') -- then the burst; the next vowel glides out of the closure
    set_var rv_t RV_DUR_CLOSURE_V
    set_condexp rv_sounding == RV_SIL
    do_if Condexp
        set_var rv_row RV_SIL
    else
        set_var rv_row RV_VB
        add_var rv_row rv_pitch
    enddo
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BD
    call_func rv_burst
    call_func rv_wait
return
def_func say_G
    # 'g': the closure -- the voice bar when the voice is sounding before it (between
    # voiced sounds), silence after a silence (iteration 5: the bar alone was heard as a
    # nasal, 'ngood') -- then the burst; the next vowel glides out of the closure
    # iteration 6: the burst one class softer (3 kHz, 10 us, 5 ms): 'too sharp'
    set_var rv_t RV_DUR_CLOSURE_V
    set_condexp rv_sounding == RV_SIL
    do_if Condexp
        set_var rv_row RV_SIL
    else
        set_var rv_row RV_VB
        add_var rv_row rv_pitch
    enddo
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BG
    call_func rv_burst
    call_func rv_wait
return
def_func say_B3
    # 'b': the closure -- the voice bar when the voice is sounding before it (between
    # voiced sounds), silence after a silence (iteration 5: the bar alone was heard as a
    # nasal, 'ngood') -- then the burst; the next vowel glides out of the closure
    # iteration 6: the 'b' of iteration 3, its strong burst (2 kHz, 250 us pulses, 3 ms), for
    # ROBOVOX (the PJT, 23.10.2026); say_B keeps the soft burst of iterations 4 and 5
    set_var rv_t RV_DUR_CLOSURE_V
    set_condexp rv_sounding == RV_SIL
    do_if Condexp
        set_var rv_row RV_SIL
    else
        set_var rv_row RV_VB
        add_var rv_row rv_pitch
    enddo
    call_func rv_voice_set
    call_func rv_wait
    set_var rv_t RV_DUR_BURST
    set_var rv_nrow RV_BB3
    call_func rv_burst
    call_func rv_wait
return
def_func say_S
    # 's': timed hiss (4 us pulses, 100 ms, soft attack), voice silent
    set_var rv_t RV_DUR_S
    set_var rv_nrow RV_NS
    call_func rv_burst
    set_var rv_row RV_SIL
    call_func rv_voice_only
    call_func rv_wait
return
