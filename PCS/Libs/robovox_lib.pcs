Pardus pcs 1
make_lib

###############################################################################
#  robovox_lib.pcs  --  THE ROBOVOX LIBRARY (iteration 7p5, final), as PCS    #
#  source                                                                     #
#                                                                             #
#  TO MAKE THE LIBRARY: load this file into pardclient and press Run.  Its    #
#  first                                                                      #
#  command, make_lib, makes the client check the Rules for Libs and save the  #
#  compiled library robovox7_lib.pcl (by default beside this file); main is   #
#  NOT run.  Remake it whenever the client gains new op codes.                #
#  TO USE IT: the line after a script's magic line:  add_lib robovox7_lib.pcl #
#  then #include stdpard.pch and #include robovox7.pch, as this file does.    #
#  TO TRY IT AS A SCRIPT: comment out make_lib; main then says HELLO WORLD.   #
#                                                                             #
#  Generated by rv_generate7.py from rv_inventory7.py (29 October 2026).      #
#  Prepared for PJT.  FIRMWARE: parduino_fixed11 (his own).                   #
#  Documentation:                                                             #
#  docs/ROBOVOX_Library_Manual (odt, md, tex, pdf), iteration 7.              #
###############################################################################

#include stdpard.pch
#include robovox.pch

# ---------------------------------------------------------------------------
# ROBOVOX global variables (PCS variables are global; all are defined here).
# ---------------------------------------------------------------------------
def_var string rv_actname1 _      # name of an actuator found at the voice index
def_var string rv_actname2 _      # name of an actuator found at the noise index
def_var string rv_msg _           # console messages
def_var int   rv_row 0            # voice row about to be sent
def_var int   rv_nrow 0           # noise row about to be sent
def_var int   rv_grow 0           # glide row about to be sent
def_var int   rv_sounding 0       # voice row now sounding (RV_SIL when silent)
def_var int   rv_glide -1         # glide row now in force on the voice (-1: none set yet)
def_var int   rv_last_noise -1    # last noise row sent
def_var int   rv_noise_on 0       # 1 while a CONTINUOUS noise sounds (a timed one ends by itself)
def_var int   rv_shape 0          # base row of a voice shape (its row at pitch level 0)
def_var int   rv_shape2 0         # second shape of a diphthong
def_var int   rv_pitch 4          # pitch level 0..11 (RV_P_FLOOR = 87 Hz)
def_var int   rv_p2 0             # pitch level at the end of a contour
def_var int   rv_tgt 0            # 1 = the next vowel is a contour ending at rv_p2 (to_Pk, FALL, RISE)
def_var int   rv_gcont 0          # glide row of the contour being made
def_var int   rv_fall_steps 3     # levels of a FALL (RV_FALL_STEPS; a script may change it)
def_var int   rv_wy 0             # 1 = the next vowel walks out of a w or y (RV_G_WY in force)
def_var float rv_rate 1.0         # tempo of vowels, sonorants and gaps: 1.0 normal, RV_FAST_RATE faster
def_var float rv_dmul 1.0         # duration factor of the next vowel or sonorant (UNSTR, LONG, FINAL)
def_var float rv_dur 0.0          # duration (s) of the gesture being made
def_var float rv_half 0.0         # half of a diphthong
def_var float rv_t 0.0            # time (s) still to sleep in the gesture
def_var int   rv_i 0              # index used by rv_speak
def_var int   rv_seq_len 0        # number of entries of rv_seq to play
def_array string rv_seq 96 say_PAUSE   # a word or sentence as a list of function names

def_func main
    # The library's own test (not copied into the library): HELLO WORLD once.
    call_func rv_init
    set_str rv_msg ROBOVOX library 7: self-test, HELLO WORLD
    print_value rv_msg 2
    call_func pitch_P7
    call_func say_H
    call_func UNSTR
    call_func say_EH
    call_func pitch_P10
    call_func say_L
    call_func to_P9
    call_func say_OU
    call_func say_PAUSE
    call_func say_W
    call_func pitch_P8
    call_func FINAL
    call_func to_P4
    call_func say_ER
    call_func say_L
    call_func say_D
    call_func say_GAP
    call_func rv_finish
return
# ===========================================================================
#  ROBOVOX FUNCTION LIBRARY, iteration 7 (generated by rv_generate7.py; do not edit by hand)
# ===========================================================================
def_func rv_init
    # Free whatever occupies our two M-Level indices or names, define the
    # voice and noise actuators and load their tables.
    get_actuators
    act_getname ACT_MLEVEL RV_VOICE_INDEX rv_actname1
    set_condexp rv_actname1 != null
    do_if Condexp
        undef_actuator rv_actname1
    enddo
    act_getname ACT_MLEVEL RV_NOISE_INDEX rv_actname2
    set_condexp rv_actname2 != null
    do_if Condexp
        undef_actuator rv_actname2
    enddo
    get_actuators
    act_getid RV_voice
    set_condexp CurrActIdx >= 0
    do_if Condexp
        undef_actuator RV_voice
    enddo
    act_getid RV_noise
    set_condexp CurrActIdx >= 0
    do_if Condexp
        undef_actuator RV_noise
    enddo
    # The voice: PWM M-Level on the 16-bit Timer 1 (pre-scaler BEFORE the pin).
    def_actuator ACT_MLEVEL RV_VOICE_INDEX RV_voice
    act_set RV_voice INFO_ML_TYPE MLT_PWM
    act_set RV_voice INFO_ML_PSC  RV_VOICE_PSC
    act_set RV_voice INFO_PIN_P0  RV_VOICE_PIN
    # The noise channel: PWM M-Level on the 8-bit Timer 2.
    def_actuator ACT_MLEVEL RV_NOISE_INDEX RV_noise
    act_set RV_noise INFO_ML_TYPE MLT_PWM
    act_set RV_noise INFO_ML_PSC  RV_NOISE_PSC
    act_set RV_noise INFO_PIN_P0  RV_NOISE_PIN
    # Translation tables (rows appended strictly in order from 0; duty in per mille).
    act_set RV_voice INFO_ML_TTABLE 0   0     0      # RV_SIL silence (clean: OCR 0)
    act_set RV_voice INFO_ML_TTABLE 1   69    85     # RV_EE [69 Hz]
    act_set RV_voice INFO_ML_TTABLE 2   73    90     # (RV_EE+1) [73 Hz]
    act_set RV_voice INFO_ML_TTABLE 3   78    96     # (RV_EE+2) [78 Hz]
    act_set RV_voice INFO_ML_TTABLE 4   82    101    # (RV_EE+3) [82 Hz]
    act_set RV_voice INFO_ML_TTABLE 5   87    107    # (RV_EE+4) [87 Hz]
    act_set RV_voice INFO_ML_TTABLE 6   92    113    # (RV_EE+5) [92 Hz]
    act_set RV_voice INFO_ML_TTABLE 7   98    121    # (RV_EE+6) [98 Hz]
    act_set RV_voice INFO_ML_TTABLE 8   103   127    # (RV_EE+7) [103 Hz]
    act_set RV_voice INFO_ML_TTABLE 9   110   135    # (RV_EE+8) [110 Hz]
    act_set RV_voice INFO_ML_TTABLE 10  116   143    # (RV_EE+9) [116 Hz]
    act_set RV_voice INFO_ML_TTABLE 11  123   151    # (RV_EE+10) [123 Hz]
    act_set RV_voice INFO_ML_TTABLE 12  130   160    # (RV_EE+11) [130 Hz]
    act_set RV_voice INFO_ML_TTABLE 13  69    82     # RV_IH [69 Hz]
    act_set RV_voice INFO_ML_TTABLE 14  73    87     # (RV_IH+1) [73 Hz]
