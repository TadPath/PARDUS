def_func pitch_LO
    # = pitch_P4 (the floor)
    set_var rv_pitch RV_P_LO
return
def_func pitch_MID
    # = pitch_P5
    set_var rv_pitch RV_P_MID
return
def_func pitch_HI
    # = pitch_P7
    set_var rv_pitch RV_P_HI
return
def_func pitch_UP
    # one semitone up (at most the top level)
    set_condexp rv_pitch < RV_P_TOP
    do_if Condexp
        add_var rv_pitch 1
    enddo
return
def_func pitch_DOWN
    # one semitone down (at least level 0)
    set_condexp rv_pitch > 0
    do_if Condexp
        sub_var rv_pitch 1
    enddo
return
def_func UNSTR
    # the next vowel or sonorant is unstressed: x RV_UNSTRESSED
    set_var rv_dmul RV_UNSTRESSED
return
def_func LONG
    # the next vowel or sonorant is lengthened: x RV_LENGTHEN
    set_var rv_dmul RV_LENGTHEN
return
def_func FINAL
    # the next vowel ends a phrase: lengthened (x RV_LENGTHEN)
    set_var rv_dmul RV_LENGTHEN
return
def_func FALL
    # The next vowel ends a phrase: lengthened, and it glides down rv_fall_steps levels.
    set_var rv_p2 rv_pitch
    sub_var rv_p2 rv_fall_steps
    set_condexp rv_p2 < 0
    do_if Condexp
        set_var rv_p2 0
    enddo
    set_condexp rv_p2 > RV_P_TOP
    do_if Condexp
        set_var rv_p2 RV_P_TOP
    enddo
    set_var rv_tgt 1
    set_var rv_dmul RV_LENGTHEN
return
def_func RISE
    # The next vowel rises (a question): lengthened, up RV_RISE_STEPS levels.
    set_var rv_p2 rv_pitch
    add_var rv_p2 RV_RISE_STEPS
    set_condexp rv_p2 < 0
    do_if Condexp
        set_var rv_p2 0
    enddo
    set_condexp rv_p2 > RV_P_TOP
    do_if Condexp
        set_var rv_p2 RV_P_TOP
    enddo
    set_var rv_tgt 1
    set_var rv_dmul RV_LENGTHEN
return
def_func say_GAP
    # Silence on both channels (RV_DUR_GAP, scaled by rv_rate).
    set_var rv_t RV_DUR_GAP
    mul_var rv_t rv_rate
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
return
def_func say_PAUSE
    # Silence on both channels (RV_DUR_PAUSE, scaled by rv_rate).
    set_var rv_t RV_DUR_PAUSE
    mul_var rv_t rv_rate
    set_var rv_row RV_SIL
    call_func rv_voice_set
    call_func rv_wait
return
