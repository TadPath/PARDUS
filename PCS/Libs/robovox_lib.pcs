    act_set RV_voice INFO_ML_TTABLE 194 25000 25     # RV_PRIME inaudible (25 kHz, 1 us pulses): hooks the voice pin once, in rv_init
    act_set RV_voice INFO_ML_TTABLE 195 0     4000   # RV_G0 glide time 0 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 196 0     4020   # RV_G20 glide time 20 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 197 0     4040   # RV_G40 glide time 40 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 198 0     4080   # RV_G80 glide time 80 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 199 0     4150   # RV_G150 glide time 150 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 200 0     4200   # RV_G200 glide time 200 ms (a setting; nothing audible changes)
    act_set RV_voice INFO_ML_TTABLE 201 0     4250   # RV_G250 glide time 250 ms (a setting; nothing audible changes)
    act_set RV_noise INFO_ML_TTABLE 0   0     0      # RV_NSIL no noise (pin LOW)
    act_set RV_noise INFO_ML_TTABLE 1   0     4003   # RV_NATT the ATTACK STEP of the noise channel (a setting, sent once by rv_init)
    act_set RV_noise INFO_ML_TTABLE 2   16000 2300   # RV_NS 's': class 3 (4 us), 100 ms, -7 dB (as iteration 4: heard 's' alone)
    act_set RV_noise INFO_ML_TTABLE 3   15999 2300   # (RV_NS+1) alternate of RV_NS (same sound)
    act_set RV_noise INFO_ML_TTABLE 4   16000 1250   # RV_NSH 'sh': continuous, 250 per mille (15.5 us), +4.6 dB (iteration 4: the 8 kHz telegraph, +15 dB, 'tsshh')
    act_set RV_noise INFO_ML_TTABLE 5   16000 2480   # RV_NF 'f': class 4 (2 us), 80 ms, -13 dB (iteration 4: class 5, -19 dB)
    act_set RV_noise INFO_ML_TTABLE 6   15999 2480   # (RV_NF+1) alternate of RV_NF (same sound)
    act_set RV_noise INFO_ML_TTABLE 7   16000 2399   # RV_NTH 'th': class 3 (4 us), 99 ms (iteration 5: class 4; calibration 5, pair 9: one class louder [better])
    act_set RV_noise INFO_ML_TTABLE 8   15999 2399   # (RV_NTH+1) alternate of RV_NTH (same sound)
    act_set RV_noise INFO_ML_TTABLE 9   16000 2380   # RV_NV 'v': class 3 (4 us), 80 ms, over the voice bar (iteration 5: the 'f' hiss, class 4; iteration 3's level: 'v' heard as 'b')
    act_set RV_noise INFO_ML_TTABLE 10  15999 2380   # (RV_NV+1) alternate of RV_NV (same sound)
    act_set RV_noise INFO_ML_TTABLE 11  16000 2395   # RV_NH 'h': class 3 (4 us), 95 ms, -7 dB (iteration 4: class 4; H3 'best', 21.10)
    act_set RV_noise INFO_ML_TTABLE 12  15999 2395   # (RV_NH+1) alternate of RV_NH (same sound)
    act_set RV_noise INFO_ML_TTABLE 13  16000 1064   # RV_NHC 'h' of say_H (iteration 7): the same 4 us pulses at 16 kHz, CONTINUOUS (E = 1, 64 per mille), switched off by the vowel that follows: it covers the vowel's walk out of the bar
    act_set RV_noise INFO_ML_TTABLE 14  2500  2599   # RV_NTHD 'th', darker (say_THD): 2.5 kHz clock, class 5 (6 us), 99 ms; centroid 11 % below RV_NTH at the same level (tests/t44_dark_th.py)
    act_set RV_noise INFO_ML_TTABLE 15  2499  2599   # (RV_NTHD+1) alternate of RV_NTHD (same sound)
    act_set RV_noise INFO_ML_TTABLE 16  16000 3250   # RV_NCH 'ch', 'j': the 10 ms burst (31.5 us) then the 'sh' noise (15.5 us)
    act_set RV_noise INFO_ML_TTABLE 17  16000 2010   # RV_BT 't' burst: iteration 3's (16 kHz, 500 per mille = 31.5 us, 10 ms), +10 dB
    act_set RV_noise INFO_ML_TTABLE 18  15999 2010   # (RV_BT+1) alternate of RV_BT (same sound)
    act_set RV_noise INFO_ML_TTABLE 19  3000  2012   # RV_BK 'k' burst: iteration 3's (3 kHz, 166 us pulses, 12 ms), +15 dB
    act_set RV_noise INFO_ML_TTABLE 20  3001  2012   # (RV_BK+1) alternate of RV_BK (same sound)
    act_set RV_noise INFO_ML_TTABLE 21  2000  2006   # RV_BP 'p' burst between sounds: iteration 3's (2 kHz, 250 us pulses, 6 ms), +12 dB
    act_set RV_noise INFO_ML_TTABLE 22  1999  2006   # (RV_BP+1) alternate of RV_BP (same sound)
    act_set RV_noise INFO_ML_TTABLE 23  2000  2406   # RV_BPI 'p' burst after a silence (word start): 2 kHz, class 4 (15.6 us), 6 ms (iteration 6: class 5, 7.8 us, 'a little bit too weak')
    act_set RV_noise INFO_ML_TTABLE 24  1999  2406   # (RV_BPI+1) alternate of RV_BPI (same sound)
    act_set RV_noise INFO_ML_TTABLE 25  16000 2205   # RV_BD 'd' burst: 16 kHz, class 2 (8 us), 5 ms, -1 dB
    act_set RV_noise INFO_ML_TTABLE 26  15999 2205   # (RV_BD+1) alternate of RV_BD (same sound)
    act_set RV_noise INFO_ML_TTABLE 27  3000  2405   # RV_BG 'g' burst: 3 kHz, class 4 (10 us), 5 ms (iteration 5: class 2, 'too sharp')
    act_set RV_noise INFO_ML_TTABLE 28  3001  2405   # (RV_BG+1) alternate of RV_BG (same sound)
    act_set RV_noise INFO_ML_TTABLE 29  2000  2603   # RV_BB 'b' burst: 2 kHz, class 6, 3 ms (as iterations 4 and 5)
    act_set RV_noise INFO_ML_TTABLE 30  1999  2603   # (RV_BB+1) alternate of RV_BB (same sound)
    act_set RV_noise INFO_ML_TTABLE 31  2000  2003   # RV_BB3 'b' burst of iteration 3: 2 kHz, 250 us pulses, 3 ms (say_B3, ROBOVOX)
    act_set RV_noise INFO_ML_TTABLE 32  1999  2003   # (RV_BB3+1) alternate of RV_BB3 (same sound)
    # fixed7/fixed9: the attack step of every continuous noise and timed fricative (a setting; nothing sounds)
    act_set RV_noise INFO_ML_LEVEL RV_NATT
    set_var rv_sounding RV_SIL
    set_var rv_glide -1
    set_var rv_wy 0
    set_var rv_last_noise -1
    set_var rv_noise_on 0
    set_var rv_pitch RV_P_FLOOR
    set_var rv_fall_steps RV_FALL_STEPS
    set_var rv_tgt 0
    set_var rv_dmul 1.0
    set_var rv_t 0.0
    set_var rv_grow RV_G_DEF
    call_func rv_glide_set      # the default glide, once
    # Put the voice pin on its timer once, inaudibly (25 kHz, 1 us pulses), then into the clean
    # silence (on its timer, OCR = 0, output LOW): every later vowel after a silence is then the
    # clean onset of fixed7 (whole first pulse, 1.5 periods after its order).
    act_set RV_voice INFO_ML_LEVEL RV_PRIME
    act_set RV_voice INFO_ML_LEVEL RV_SIL
    sleep 1.0                    # let the hardware settle (as in the PJT's scripts)
return
def_func rv_finish
    # Silence both channels.  The voice is given the silent row: the CLEAN silence
    # (its pin stays on its timer with OCR = 0, the output LOW).  It is NOT halted
    # (review of 21 October 2026): a halted pin is unhooked, and the next vowel
    # would then start without the clean onset, up to 32.8 ms late.  The noise
    # channel is halted.
    set_condexp rv_sounding != RV_SIL
    do_if Condexp
        act_set RV_voice INFO_ML_LEVEL RV_SIL
    enddo
    act_halt RV_noise
    set_var rv_sounding RV_SIL
    set_var rv_last_noise -1
    set_var rv_noise_on 0
    set_var rv_tgt 0
    set_var rv_dmul 1.0
    # iteration 5: a w or y left at the end of a word leaves RV_G_WY in force: restore the default
    set_var rv_wy 0
    set_var rv_grow RV_G_DEF
    call_func rv_glide_set
    set_var rv_t 0.0
return
def_func rv_wait
    # Sleep whatever remains of the gesture (never a negative time).
    set_condexp rv_t > 0.0
    do_if Condexp
        sleep rv_t
    enddo
    set_var rv_t 0.0
return
def_func rv_glide_set
    # Set the glide time of the voice to the E = 4 row rv_grow, unless it is in force.
    set_condexp rv_grow != rv_glide
    do_if Condexp
        act_set RV_voice INFO_ML_LEVEL rv_grow
        sub_var rv_t RV_LATENCY
        set_var rv_glide rv_grow
    enddo
return
def_func rv_voice_only
    # Send the voice row rv_row unless it is already sounding (a contour restores
    # the default glide itself, so nothing is owed here).
    set_condexp rv_row != rv_sounding
    do_if Condexp
        act_set RV_voice INFO_ML_LEVEL rv_row
        sub_var rv_t RV_LATENCY
        set_var rv_sounding rv_row
    enddo
return
def_func rv_voice_set
    # rv_voice_only, then switch off a CONTINUOUS noise left on by the previous
    # consonant ('sh', 'ch'): just after the new voice sound begins.
    call_func rv_voice_only
    do_if rv_noise_on
        act_set RV_noise INFO_ML_LEVEL RV_NSIL
        sub_var rv_t RV_LATENCY
        set_var rv_noise_on 0
        set_var rv_last_noise RV_NSIL
    enddo
return
def_func rv_noise_set
    # Start the continuous noise rv_nrow (E = 1 or 3) unless it is already on.
    set_condexp rv_nrow != rv_last_noise
    do_if Condexp
        act_set RV_noise INFO_ML_LEVEL rv_nrow
        sub_var rv_t RV_LATENCY
        set_var rv_last_noise rv_nrow
    enddo
    set_var rv_noise_on 1
return
def_func rv_burst
    # A TIMED noise (E = 2: a burst, or a fricative that ends by itself).  The same
    # row twice in a row uses the alternate row (row + 1: the same sound, other values).
    set_condexp rv_nrow == rv_last_noise
    do_if Condexp
        add_var rv_nrow 1
    enddo
    act_set RV_noise INFO_ML_LEVEL rv_nrow
    sub_var rv_t RV_LATENCY
    set_var rv_last_noise rv_nrow
    set_var rv_noise_on 0
return
def_func rv_vowel
    # Sound the shape rv_shape at the pitch level rv_pitch for rv_dur seconds (x the
    # tempo, x rv_dmul).  With a contour set (to_Pk, FALL, RISE) the vowel starts at
    # rv_pitch and, from its third order, glides to rv_p2 over RV_G_CONT (RV_G_LONG
    # when lengthened); its fourth order restores the default glide (the walk goes
    # on); it lasts at least RV_CONTOUR_MIN.  After a w or y (iteration 5) the vowel walks
    # out of it over RV_G_WY; its second order restores the default glide.
    mul_var rv_dur rv_rate
    mul_var rv_dur rv_dmul
    set_var rv_gcont RV_G_CONT
    set_condexp rv_dmul > 1.2
    do_if Condexp
        set_var rv_gcont RV_G_LONG       # a lengthened vowel falls over the long glide
    enddo
    set_var rv_dmul 1.0
    do_if rv_tgt
        set_condexp rv_dur < RV_CONTOUR_MIN      # room for four orders
        do_if Condexp
            set_var rv_dur RV_CONTOUR_MIN
        enddo
    enddo
    set_var rv_t rv_dur
    set_var rv_row rv_shape
    add_var rv_row rv_pitch
    call_func rv_voice_set
    do_if rv_wy
        set_condexp rv_tgt == 0
        do_if Condexp
            set_var rv_grow RV_G_DEF       # iteration 5: the walk out of the w/y runs on
            call_func rv_glide_set
        enddo
        set_var rv_wy 0
    enddo
    do_if rv_tgt
        set_var rv_grow rv_gcont
        call_func rv_glide_set
        set_var rv_row rv_shape
        add_var rv_row rv_p2
        call_func rv_voice_set
        set_var rv_pitch rv_p2          # the following sounds stay at the end level
        set_var rv_grow RV_G_DEF
        call_func rv_glide_set
        set_var rv_tgt 0
    enddo
    call_func rv_wait
return
def_func rv_diph
    # A diphthong: rv_shape for half of rv_dur, then a glide to rv_shape2.  With a
    # contour, the shape and the pitch glide together over the contour glide.
    mul_var rv_dur rv_rate
    mul_var rv_dur rv_dmul
    set_var rv_gcont RV_G_CONT
    set_condexp rv_dmul > 1.2
    do_if Condexp
        set_var rv_gcont RV_G_LONG       # a lengthened vowel falls over the long glide
    enddo
    set_var rv_dmul 1.0
    do_if rv_tgt
        set_condexp rv_dur < RV_CONTOUR_MIN      # room for four orders
        do_if Condexp
            set_var rv_dur RV_CONTOUR_MIN
        enddo
    enddo
    set_var rv_half rv_dur
    mul_var rv_half 0.5
    set_var rv_t rv_half
    set_var rv_row rv_shape
    add_var rv_row rv_pitch
    call_func rv_voice_set
    do_if rv_wy
        set_condexp rv_tgt == 0
        do_if Condexp
            set_var rv_grow RV_G_DEF       # iteration 5: the walk out of the w/y runs on
            call_func rv_glide_set
        enddo
        set_var rv_wy 0
    enddo
    do_if rv_tgt
        set_var rv_grow rv_gcont
        call_func rv_glide_set
        set_var rv_row rv_shape2
        add_var rv_row rv_p2
        call_func rv_voice_set
        add_var rv_t rv_half
        set_var rv_pitch rv_p2          # the following sounds stay at the end level
        set_var rv_grow RV_G_DEF
        call_func rv_glide_set
        set_var rv_tgt 0
    else
        call_func rv_wait
        set_var rv_t rv_half
        set_var rv_row rv_shape2
        add_var rv_row rv_pitch
        call_func rv_voice_set
    enddo
    call_func rv_wait
return
def_func pitch_P0
    # pitch level 0 = 69 Hz
    set_var rv_pitch 0
return
def_func pitch_P1
    # pitch level 1 = 73 Hz
    set_var rv_pitch 1
return
