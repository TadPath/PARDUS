Pardus pch 1

################################################################################
#  robovox.pch  -  ROBOVOX iteration 7 (final): speech from two PWM M-Levels   #
#                                                                              #
#  Generated by rv_generate7.py from rv_inventory7.py (29 October 2026).       #
#  Prepared for the PJT.  FIRMWARE: parduino_fixed11, the PJT's own of 26      #
#  October 2026 (its ROBOVOX functions are those of fixed7 to fixed10: clean   #
#  onsets, timed noises with width classes, prescaler 8 for the noise clocks). #
#                                                                              #
#  Usage: make the library ONCE: load robovox7_lib.pcs into pardclient and     #
#  press Run (its make_lib writes robovox7_lib.pcl beside it).  Then, in a     #
#  script:                                                                     #
#      Pardus pcs 1                                                            #
#      add_lib robovox7_lib.pcl          (the line after the magic line)       #
#      #include stdpard.pch                                                    #
#      #include robovox7.pch                                                   #
#  and speak with call_func say_XX (see the ROBOVOX Library Manual).           #
################################################################################

# ----------------------------------------------------------------------------
# HARDWARE: Arduino Nano (ATmega328P); ROBOVOX_Circuits, Figure 1 (current-sink cells, one speaker)
#   VOICE on D9 = Timer 1 (16-bit), PWM_PSC_8: vowels, nasals, l, r, voice bar
#   NOISE on D3 = Timer 2 (8-bit),  PWM_PSC_32: fricatives, bursts, h
#   (parduino_fixed7 to fixed11 run a noise clock of 7813 Hz or more on prescaler 8)
# ----------------------------------------------------------------------------
#define RV_VOICE_PIN     9
#define RV_NOISE_PIN     3
#define RV_VOICE_PSC     3      # = PWM_PSC_8
#define RV_NOISE_PSC     5      # = PWM_PSC_32
#define RV_VOICE_INDEX   1      # M-Level index of the voice
#define RV_NOISE_INDEX   2      # M-Level index of the noise channel

# ----------------------------------------------------------------------------
# TIMING: one level order = one client-server-Arduino round trip (51.4 ms).
#   Every duration below INCLUDES the round trips of its gesture.
# ----------------------------------------------------------------------------
#define RV_LATENCY       0.0514
#define RV_UNSTRESSED    0.7      # UNSTR: the next vowel or sonorant x this
#define RV_LENGTHEN      1.5       # LONG, FINAL (and FALL, RISE): x this
#define RV_CONTOUR_MIN   0.2056   # a contour vowel: its four orders
#define RV_FAST_RATE     0.8333   # the faster tempo of the menu (iteration 4's); the default is 1.0

# ----------------------------------------------------------------------------
# PITCH LEVELS 0..11 (voice fundamental, Hz), a semitone apart:
#   0: 69  1: 73  2: 78  3: 82  4: 87  5: 92  6: 98  7: 103  8: 110  9: 116  10: 123  11: 130
#   Level 4 (87 Hz) is the FLOOR of every word (as in iterations 5 and 6).
#   A voice row is  RV_<shape> + <pitch level>;  the global rv_pitch holds the level.
# ----------------------------------------------------------------------------
#define RV_NPITCH        12
#define RV_P_TOP         11
#define RV_P_FLOOR       4
#define RV_P_LO          4
#define RV_P_MID         5
#define RV_P_HI          7
#define RV_FALL_STEPS    3      # FALL: the next vowel glides down this many levels
#define RV_RISE_STEPS    2      # RISE: up this many

# ----------------------------------------------------------------------------
# VOICE TABLE (RV_voice).  Row 0 = silence.  Each SHAPE occupies 12 rows,
# one per pitch level; the duty is chosen so that the PULSE WIDTH tau (and
# hence the first spectral null N1 = 1/tau, the vowel colour) is the same at
# every pitch.  At the floor (87 Hz):
# ----------------------------------------------------------------------------
#define RV_SIL           0
#define RV_EE           1     # rows 1..12; at 87 Hz: duty 107, tau  1230 us  N1    813 Hz  validated: 'ee' as in fleece  [heard 'ee' at 1231 us, 17.10]
#define RV_IH           13    # rows 13..24; at 87 Hz: duty 104, tau  1195 us  N1    837 Hz  candidate: 'i' as in kit: a short 'ee'
#define RV_EH           25    # rows 25..36; at 87 Hz: duty 500, duty fixed 500 per mille (p = 0.50)     validated: 'e' as in dress: the square wave  [heard 'eh']
#define RV_AE           37    # rows 37..48; at 87 Hz: duty  53, tau   609 us  N1   1642 Hz  validated: 'a' as in trap  [heard 'ah' at 615 us]
#define RV_ER           49    # rows 49..60; at 87 Hz: duty  67, tau   770 us  N1   1299 Hz  validated: 'er' as in nurse  [heard 'er' at 769 us, 17.10]
#define RV_UH           61    # rows 61..72; at 87 Hz: duty  27, tau   310 us  N1   3226 Hz  validated: 'u' as in strut  [heard 'ah' at 308 us]
#define RV_AH           73    # rows 73..84; at 87 Hz: duty 124, tau  1425 us  N1    702 Hz  label: 'ah' as in palm  [heard 'ah' at 1420 us, 18.10]
#define RV_OH           85    # rows 85..96; at 87 Hz: duty 161, tau  1851 us  N1    540 Hz  label: 'o' as in lot: a short 'oh'  [heard 'oh' at 1846 us]
#define RV_AW           97    # rows 97..108; at 87 Hz: duty 165, tau  1897 us  N1    527 Hz  candidate: 'aw' as in thought  [next to 'oh']
#define RV_OO           109   # rows 109..120; at 87 Hz: duty  80, tau   920 us  N1   1087 Hz  validated: 'oo' as in foot  [heard 'ou' at 923 us]
#define RV_UU           121   # rows 121..132; at 87 Hz: duty 201, tau  2310 us  N1    433 Hz  validated: 'oo' as in goose  [heard 'ou' at 2308 us]
#define RV_AX           133   # rows 133..144; at 87 Hz: duty  65, tau   747 us  N1   1339 Hz  candidate: schwa, 'a' in about: a short 'er'
#define RV_LL           145   # rows 145..156; at 87 Hz: duty 450, duty fixed 450 per mille (p = 0.45)     validated: 'l' colour (p = 0.45)
#define RV_VB           157   # rows 157..168; at 87 Hz: duty   1, tau    11 us  N1  90909 Hz  label: voice bar: the closure of b, d, g BETWEEN voiced sounds, and under z, v, dh; the decay of a final 'ng'
#define RV_NM           169   # rows 169..180; at 87 Hz: duty   3, tau    34 us  N1  29412 Hz  label: nasal murmur m, n, ng (31 us, -7.8 dB re a vowel by H4; 'N31 ... best of 4, 5 and 6', 21.10)
#define RV_NN           181   # rows 181..192; at 87 Hz: duty   4, tau    46 us  N1  21739 Hz  model: the wider murmur of iteration 4 (46 us, about 3 dB above NM): kept for the calibration only
#define RV_RR           193   # 28 Hz, duty 50: trilled 'rr' (28 clicks per second, 50 per mille; heard 'rah' rolled; 'robot' 21.10)
#define RV_PRIME        194   # 25000 Hz, duty 25: inaudible (25 kHz, 1 us pulses): hooks the voice pin once, in rv_init
# Glide settings (code 4000 + ms; sent to RV_voice; nothing audible changes):
#define RV_G0           195   # code 4000
#define RV_G20          196   # code 4020
#define RV_G40          197   # code 4040
#define RV_G80          198   # code 4080
#define RV_G150         199   # code 4150
#define RV_G200         200   # code 4200
#define RV_G250         201   # code 4250
#define RV_G_DEF         197   # = RV_G40: in force within words
#define RV_G_CONT        199   # = RV_G150: the fall or rise within a vowel
#define RV_G_LONG        200   # = RV_G200: that of a lengthened vowel
#define RV_G_WY          199   # = RV_G150: the vowel after a w or y walks out of it

# ----------------------------------------------------------------------------
# NOISE TABLE (RV_noise, Timer 2).  Row 0 = no noise.  A TIMED row (E = 2: it
# ends by itself; a fricative of 30 ms or more starts softly, a burst sharply)
# is followed by an ALTERNATE copy (row + 1) one hertz away: the same sound,
# so that a repeat is never taken for "the same level".
# ----------------------------------------------------------------------------
#define RV_NSIL          0
#define RV_NATT         1     # code 4003: attack step 3 ms, sent once by rv_init
#define RV_NS           2     # 16000 Hz, code 2300 (timed): clock 16000 Hz (prescaler 8), pulse 8 x 0.5 us, 100.0 ms, soft attack  validated: 's': class 3 (4 us), 100 ms, -7 dB (as iteration 4: heard 's' alone)
#define RV_NSH          4     # 16000 Hz, code 1250 (cont): clock 16000 Hz (prescaler 8), pulse 31 x 0.5 us, soft attack  model: 'sh': continuous, 250 per mille (15.5 us), +4.6 dB (iteration 4: the 8 kHz telegraph, +15 dB, 'tsshh')
#define RV_NF           5     # 16000 Hz, code 2480 (timed): clock 16000 Hz (prescaler 8), pulse 4 x 0.5 us, 80.0 ms, soft attack  model: 'f': class 4 (2 us), 80 ms, -13 dB (iteration 4: class 5, -19 dB)
#define RV_NTH          7     # 16000 Hz, code 2399 (timed): clock 16000 Hz (prescaler 8), pulse 8 x 0.5 us, 99.0 ms, soft attack  evidence: 'th': class 3 (4 us), 99 ms (iteration 5: class 4; calibration 5, pair 9: one class louder [better])
#define RV_NV           9     # 16000 Hz, code 2380 (timed): clock 16000 Hz (prescaler 8), pulse 8 x 0.5 us, 80.0 ms, soft attack  evidence: 'v': class 3 (4 us), 80 ms, over the voice bar (iteration 5: the 'f' hiss, class 4; iteration 3's level: 'v' heard as 'b')
#define RV_NH           11    # 16000 Hz, code 2395 (timed): clock 16000 Hz (prescaler 8), pulse 8 x 0.5 us, 95.0 ms, soft attack  evidence: 'h': class 3 (4 us), 95 ms, -7 dB (iteration 4: class 4; H3 'best', 21.10)
#define RV_NHC          13    # 16000 Hz, code 1064 (cont): clock 16000 Hz (prescaler 8), pulse 8 x 0.5 us, soft attack  model: 'h' of say_H (iteration 7): the same 4 us pulses at 16 kHz, CONTINUOUS (E = 1, 64 per mille), switched off by the vowel that follows: it covers the vowel's walk out of the bar
#define RV_NTHD         14    # 2500 Hz, code 2599 (timed): clock 2500 Hz (prescaler 32), pulse 3 x 2.0 us, 98.8 ms, soft attack  model: 'th', darker (say_THD): 2.5 kHz clock, class 5 (6 us), 99 ms; centroid 11 % below RV_NTH at the same level (tests/t44_dark_th.py)
#define RV_NCH          16    # 16000 Hz, code 3250 (cont): clock 16000 Hz (prescaler 8), pulse 63 x 0.5 us, 10.0 ms  candidate: 'ch', 'j': the 10 ms burst (31.5 us) then the 'sh' noise (15.5 us)
#define RV_BT           17    # 16000 Hz, code 2010 (timed): clock 16000 Hz (prescaler 8), pulse 63 x 0.5 us, 10.0 ms  evidence: 't' burst: iteration 3's (16 kHz, 500 per mille = 31.5 us, 10 ms), +10 dB
#define RV_BK           19    # 3000 Hz, code 2012 (timed): clock 3012 Hz (prescaler 32), pulse 83 x 2.0 us, 12.0 ms  evidence: 'k' burst: iteration 3's (3 kHz, 166 us pulses, 12 ms), +15 dB
#define RV_BP           21    # 2000 Hz, code 2006 (timed): clock 2000 Hz (prescaler 32), pulse 125 x 2.0 us, 6.0 ms  evidence: 'p' burst between sounds: iteration 3's (2 kHz, 250 us pulses, 6 ms), +12 dB
#define RV_BPI          23    # 2000 Hz, code 2406 (timed): clock 2000 Hz (prescaler 32), pulse 8 x 2.0 us, 6.0 ms  evidence: 'p' burst after a silence (word start): 2 kHz, class 4 (15.6 us), 6 ms (iteration 6: class 5, 7.8 us, 'a little bit too weak')
#define RV_BD           25    # 16000 Hz, code 2205 (timed): clock 16000 Hz (prescaler 8), pulse 16 x 0.5 us, 5.0 ms  model: 'd' burst: 16 kHz, class 2 (8 us), 5 ms, -1 dB
#define RV_BG           27    # 3000 Hz, code 2405 (timed): clock 3012 Hz (prescaler 32), pulse 5 x 2.0 us, 5.0 ms  candidate: 'g' burst: 3 kHz, class 4 (10 us), 5 ms (iteration 5: class 2, 'too sharp')
#define RV_BB           29    # 2000 Hz, code 2603 (timed): clock 2000 Hz (prescaler 32), pulse 2 x 2.0 us, 3.0 ms  validated: 'b' burst: 2 kHz, class 6, 3 ms (as iterations 4 and 5)
#define RV_BB3          31    # 2000 Hz, code 2003 (timed): clock 2000 Hz (prescaler 32), pulse 125 x 2.0 us, 3.0 ms  candidate: 'b' burst of iteration 3: 2 kHz, 250 us pulses, 3 ms (say_B3, ROBOVOX)

# ----------------------------------------------------------------------------
# DURATIONS (s) of a STRESSED vowel within a word; vowels, sonorants, gaps
# and pauses are multiplied by the tempo rv_rate (1.0, or RV_FAST_RATE).
# ----------------------------------------------------------------------------
#define RV_DUR_EE         0.216
#define RV_DUR_IH         0.132
#define RV_DUR_EH         0.204
#define RV_DUR_AE         0.240
#define RV_DUR_ER         0.264
#define RV_DUR_UH         0.180
#define RV_DUR_AH         0.300
#define RV_DUR_OH         0.204
#define RV_DUR_AW         0.264
#define RV_DUR_OO         0.168
#define RV_DUR_UU         0.240
#define RV_DUR_AX         0.108
#define RV_DUR_LL         0.120
#define RV_DUR_VB         0.060
#define RV_DUR_NM         0.150
#define RV_DUR_NN         0.150
#define RV_DUR_AY         0.288   # 'i' as in price: AH gliding to EE
#define RV_DUR_EY         0.288   # 'a' as in face: EH gliding to EE
#define RV_DUR_OY         0.312   # 'oy' as in choice: AW gliding to EE
#define RV_DUR_OW         0.312   # 'ow' as in mouth: AH gliding to UU
#define RV_DUR_OU         0.288   # 'o' as in goat ('oh' gliding to 'ou'): OH gliding to UU
#define RV_DUR_IA         0.288   # 'ear' as in near: IH gliding to AX
#define RV_DUR_CLOSURE_VL 0.0600
#define RV_DUR_CLOSURE_V  0.0600
#define RV_DUR_BURST      0.0514
#define RV_DUR_RR         0.1170
#define RV_DUR_RX         0.0600
#define RV_DUR_NG         0.2160
#define RV_DUR_N0         0.2000
#define RV_DUR_W          0.1030
#define RV_DUR_Y          0.1030
#define RV_DUR_H          0.1030
#define RV_DUR_H6         0.0600
#define RV_DUR_S          0.0650
#define RV_DUR_SH         0.1200
#define RV_DUR_F          0.0450
#define RV_DUR_TH         0.0650
#define RV_DUR_Z          0.1000
#define RV_DUR_V          0.0800
#define RV_DUR_ZH         0.1100
#define RV_DUR_DH         0.0700
#define RV_DUR_CH         0.1100
#define RV_DUR_PAUSE      0.1600
#define RV_DUR_GAP        0.3000

# ----------------------------------------------------------------------------
# PHONEME FUNCTIONS of the library (call_func say_XX):
#   vowels     : say_EE say_IH say_EH say_AE say_ER say_UH say_AH say_OH say_AW say_OO say_UU say_AX
#   diphthongs : say_AY say_EY say_OY say_OW say_OU say_IA
#   stops      : say_P say_T say_K (closure, burst; the burst of p is softer after a silence)
#                say_PS (a p with the soft burst everywhere)
#                say_B say_D say_G (voice bar between voiced sounds, a silent closure after
#                a silence; burst)  say_B3 (a b with the strong burst of iteration 3)
#   sonorants  : say_M say_N say_NG (murmur, about 31 us) say_L say_R (trill, halved in
#                iteration 7) say_RX (tapped r) say_W say_Y (the next vowel walks out of them)
#   fricatives : say_H (the voice bar under the hiss: the vowel walks out of it) say_H6 (the
#                h of iteration 6) say_S say_SH say_F say_TH say_THD (darker) say_Z say_ZH
#                say_V say_DH say_CH say_J say_X
#   prosody    : pitch_P0 .. pitch_P11 (the level of the next sounds),
#                to_P0 .. to_P11 (the level at which the NEXT VOWEL ENDS: a glide within it),
#                UNSTR LONG FINAL (the next vowel or sonorant x 0.7, x 1.5, x 1.5),
#                pitch_LO pitch_MID pitch_HI pitch_UP pitch_DOWN FALL RISE say_GAP say_PAUSE
#   control    : rv_init rv_finish rv_speak (plays the string array rv_seq)
# ----------------------------------------------------------------------------

exit
